# TAP development environment defaults.
#
# This file is checked in. It carries defaults so `docker compose up` works
# in a fresh clone with zero setup. Per-worktree overrides live in `.env.local`
# (gitignored) and are merged on top by `scripts/dc`. See spec-dev-multisession.md.

# Docker Compose project namespace — isolates containers, networks, and volumes
# across concurrent sessions. Override in `.env.local` for additional sessions.
COMPOSE_PROJECT_NAME=tap

# Host port mappings (container ports stay fixed at 8000 / 5432).
# Allocated in 10-port bands per session — see the port registry in the spec.
WEB_PORT=8000
POSTGRES_PORT=5432

# TAP installation identity (UUIDv7, immutable per install).
# Each isolated stack is logically a separate install — the spawn script (Phase 2)
# generates a fresh value per session. For the primary checkout this stays pinned.
TAP_GRID_ID=019c2a9a-cfdb-768e-82c5-7a037556064d

# ---------------------------------------------------------------------------
# Published image version (req-cicd-product-releases-1)
# ---------------------------------------------------------------------------
# WHICH RELEASE THIS CHECKOUT RUNS. Both images are pinned to the SAME version on
# purpose: tap-web:X.Y.Z and tap-db:X.Y.Z are two artifacts of ONE release, built
# from one commit and gated together (publish-release-tags.yml retags both from
# that commit's bytes). Never mix versions — a mismatched pair is where a web
# image's migrations meet a db image that does not provide what they expect.
#
# Bumped automatically by release-please when a release PR merges; do not hand-edit.
TAP_VERSION=0.1.4 # x-release-please-version

# Derived from TAP_VERSION so the version literal lives exactly once.
TAP_WEB_IMAGE=ghcr.io/unified-systems-com/tap-web:${TAP_VERSION}
TAP_DB_IMAGE=ghcr.io/unified-systems-com/tap-db:${TAP_VERSION}

# TO RUN A DIFFERENT VERSION (or main's tip), override in `.env.local`:
#     TAP_WEB_IMAGE=ghcr.io/unified-systems-com/tap-web:latest
#     TAP_DB_IMAGE=ghcr.io/unified-systems-com/tap-db:latest
#
# ⚠️ Override BOTH image lines — NOT TAP_VERSION. Compose interpolates the two
# image refs while reading THIS file, before `.env.local` is read, so setting
# TAP_VERSION there silently does nothing and you stay on the pinned release with
# no error. (Verified against Compose v2, 2026-08-13.)
#
# `scripts/spawn-session.sh` writes the `:latest` pair into a dev session's
# `.env.local` — development tracks main; a plain `docker compose up` gets the
# pinned release.
