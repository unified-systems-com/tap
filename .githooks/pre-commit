#!/usr/bin/env sh
# Refuse a commit carrying credential material (req-tap-cares-secrets-precommit).
#
# Delegates to precommit_secret_scan.py — stdlib-only, so it works on a bare host with
# no .venv (dependencies live in the container). See that file for what is and is not
# covered here; the CI guards remain the enforcement boundary.
#
# Deliberately fails LOUD if python3 is missing rather than passing silently: a secret
# scanner that no-ops when its interpreter is absent is worse than no scanner, because
# it still reads as a green commit.
# PROTECTIVE hook: on a consent mismatch this warns loudly and then STILL SCANS
# (req-dev-localexec-reconsent). Disabling a secret scanner is precisely what a
# hostile change would want; refusing to run would hand it the outcome. The
# certifying hook makes the opposite call, and the asymmetry is the point.
. "$(dirname "$0")/_consent_check.sh"
tap_consent_gate || true

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found — cannot run the staged secret scan." >&2
    echo "  Install python3, or bypass deliberately with 'git commit --no-verify'." >&2
    exit 1
fi

python3 "$(dirname "$0")/precommit_secret_scan.py" || exit $?

# Host-syntax floor (req-dev-localexec-host-syntax-floor, tap#400).
#
# Anything this repo runs on a HOST — these hooks, `scripts/*`, a CI `setup` step —
# starts under bare `python3`, which is not the container's 3.14. A module using newer
# grammar dies at PARSE time, before its first statement, so nothing inside it can report
# the problem and every caller sees only "the tool produced nothing".
#
# Not theoretical: `tap/bom_inputs.py` carried `except OSError, ValueError:` (3.14-only),
# `scripts/change-tier` ran it under the runner's older python3 and discarded its stderr,
# and every pull request silently ran the full ten-minute lane set instead of the
# one-minute docs lane, for weeks. Catching it here costs milliseconds and saves a push,
# a CI round trip, and a diagnosis nobody enjoys.
#
# MIRRORED, CROSS-REPO: unified-systems-com/tap-dev-hooks carries the same block at
# `payload/.githooks/pre-commit`. That repo is the intended canonical home, but tap does
# not reference or vendor it yet — nothing here mentions tap-dev-hooks — so THIS copy is
# the live one and both must be edited until the vendoring is actually wired up. Not
# tagged TAP-KNOWN-DUPE: that mechanism wants two sites in ONE repo and a guard that can
# see both, and it cannot see across a repository boundary.
#
# Guarded on the checker's presence so the same file works in a repo that does not ship
# it. Checks the whole tree rather than only staged files, because that is exactly what
# CI asserts — a hook that checks less than the gate teaches people to distrust it.
FLOOR_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || FLOOR_ROOT=""
if [ -n "$FLOOR_ROOT" ] && [ -f "$FLOOR_ROOT/tap/host_syntax_floor.py" ]; then
    if ! python3 "$FLOOR_ROOT/tap/host_syntax_floor.py"; then
        echo "pre-commit: a host-runnable module will not parse on the oldest supported interpreter." >&2
        echo "  These run under bare python3 before any container exists — CI fails the same way." >&2
        echo "  Bypass deliberately with 'git commit --no-verify' if you know why." >&2
        exit 1
    fi
fi

exit 0
