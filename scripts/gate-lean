#!/usr/bin/env bash
# scripts/gate-lean — the lean-container boot-independence gate.
#
# Stands up a GENUINELY fresh, lean-INSTALLED throwaway session — its own compose
# project (=> its own `venv` named volume => a core-only virtualenv) — and boots
# the zero-plugin `core` profile through the real spawn-off-`main` path, gating on
# `manage.py health`. Because the venv is core-only, ANY core module that imports a
# plugin-only dependency (the `requests` / `jwt` leakage class) fails at
# pre-boot / boot. The in-container cold-boot gate (`scripts/gate`) CANNOT catch
# that: it reuses the running stack's full venv (a per-compose-project named
# volume), where the leaked dependency is already importable and the leak stays
# invisible. Only a separate stack with a separate venv volume has teeth here.
#
# Spec: req-dev-validation-lean-boot / req-boot-minimal-baseline-5 (spec-tap-boot-v0.md).
#
# Isolation & teardown:
#   * The throwaway worktree is written under WORKTREE_BASE (default: system tmp),
#     NOT ~/tap-sessions — a disposable session never clutters the real sessions dir.
#   * On ANY exit (success, failure, interrupt) the throwaway is nuked: containers,
#     volumes, networks, worktree, branch, registry row — via despawn-session.sh
#     (a commitless throwaway is always CLEAN, so `--yes` tears it down unattended),
#     with an inline `compose down -v` + `worktree remove` fallback if despawn errors.
#   * On FAILURE, diagnostics (compose ps + web logs) are captured to a sibling log
#     OUTSIDE the nuked worktree BEFORE teardown, so a red gate is debuggable. For a
#     deeper post-mortem, run the /diagnose-failed-session-spawn skill.
#
# Usage:
#   scripts/gate-lean                 # spawn+boot `core`, health-gate, teardown
#   LEANBOOT_PROFILE=core_dev scripts/gate-lean   # core + grid_fixtures instead
#
# Exit code is the gate's: 0 == GREEN (lean profile booted healthy in isolation),
# non-zero == RED (blocks a promote once wired into promote-to-main.sh).

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

NAME="${LEANBOOT_NAME:-leanboot}"
PROFILE="${LEANBOOT_PROFILE:-core}"          # core = zero plugins = the strictest independence signal
export WORKTREE_BASE="${LEANBOOT_BASE:-${TMPDIR:-/tmp}/tap-leanboot}"
# A throwaway admin password: set in env so spawn's Step 0 skips the Keychain
# stash prompt (env wins the resolution ladder) — keeps the spawn non-interactive.
#
# GENERATED, NEVER INHERITED. This was `${TAP_DEV_ADMIN_PASSWORD:-…}`, which quietly
# adopted a caller-set password into the throwaway stack — and teardown now prints that
# stack's container logs into persistent CI output. So the one sentence the printing
# decision rests on ("lean-boot provisions no real credential") was true only for callers
# who happened not to export this. A `:-` default is a convenience; here it was the
# difference between a disposable string and someone's actual admin password reaching a
# CI log. Nothing needs to pass one in: the stack is destroyed at the end of this script.
export TAP_DEV_ADMIN_PASSWORD="leanboot-throwaway-$$-${RANDOM}${RANDOM}"

PROJECT="tap_${NAME}"
WORKTREE="$WORKTREE_BASE/$NAME"
DIAG="$WORKTREE_BASE/${NAME}-diag.log"

# Branch the throwaway from THIS worktree's HEAD, not `main`. In a promote,
# Step 2.5 runs after the pre-push merge but before the push, so the merged tree
# lives on the session branch HEAD while local `main` still points at the old
# origin/main — HEAD is the exact tree about to become origin/main, so that is
# what we must independence-test. Standalone, HEAD is simply the current commit.
export TAP_SPAWN_BASE_REF="${TAP_SPAWN_BASE_REF:-$(git rev-parse HEAD)}"

mkdir -p "$WORKTREE_BASE"

bold() { printf "\n\033[1m==> %s\033[0m\n" "$1"; }
info() { printf "    %s\n" "$1"; }

teardown() {
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    bold "LEAN-BOOT RED (rc=$rc) — capturing diagnostics before teardown"
    # Classify the failure so a build/network flake is never misread as an import
    # leak. Discriminator: did the `web` container ever exist? `ps -aq` lists even an
    # exited container, so empty == the image build/spawn died before any container
    # (infra); a present container that crashed on a missing module == the leak class
    # this gate exists to catch; anything else == boot/health.
    local web_cid ps_out web_out verdict
    web_cid="$(docker compose -p "$PROJECT" ps -aq web 2>/dev/null || true)"
    ps_out="$(docker compose -p "$PROJECT" ps -a 2>&1 || true)"
    web_out="$(docker compose -p "$PROJECT" logs --tail 200 web 2>&1 || true)"
    if [[ -z "$web_cid" ]]; then
      verdict="IMAGE BUILD / SPAWN INFRA — no container was ever created, so Python never ran; this is NOT an import leak. Typical cause: a registry-pull timeout (e.g. ghcr.io/astral-sh/uv:latest) inside the timed build. The gate pre-warms these now; if it recurs, run 'docker pull ghcr.io/astral-sh/uv:latest' and re-run."
    elif grep -qiE 'ModuleNotFoundError|ImportError' <<<"$web_out"; then
      verdict="LIKELY IMPORT LEAK — the container booted then crashed on a missing module (a core module importing a plugin-only dependency, the class this gate exists to catch). See web logs below."
    else
      verdict="BOOT/HEALTH — the container started but did not reach healthy (migrate/boot/health), not necessarily an import leak. See web logs below."
    fi
    {
      echo "### gate-lean failure  rc=$rc  profile=$PROFILE  project=$PROJECT"
      echo "### VERDICT: $verdict"
      echo
      echo "### compose ps -a"
      echo "$ps_out"
      echo
      echo "### web logs (tail 200)"
      echo "$web_out"
    } >"$DIAG" 2>&1 || true
    info "VERDICT: $verdict"
    info "diagnostics: $DIAG"
    # ...and print them, which until now this did not do. The verdict above says "See web
    # logs below" and there were no web logs below: they went to $DIAG, which on a CI
    # runner the teardown deletes moments later. A red lean-boot in CI was therefore
    # undiagnosable from its own log — the cause had to be inferred from step names and
    # timing. Found the hard way on PR# 759 - tap, where two fixes were pushed on inference
    # because this output existed and was thrown away.
    echo
    echo "### compose ps -a"
    echo "$ps_out"
    echo
    # Container logs into a PERSISTENT CI log is a deliberate trade, raised by the Codex seat
    # on PR# 759 - tap and worth stating rather than assuming. What makes it acceptable here:
    # this is a THROWAWAY lean-boot stack with no secrets provisioned (tap_secrets/ is empty
    # for it) and no customer data, and TAP's logging contract (spec-tap-logging.md) is that
    # credential-shaped values never reach a log in the first place. What makes it necessary:
    # without this the gate says "See web logs below" and prints none, and three rounds of
    # PR# 759 - tap were spent guessing a cause this output names in one line.
    #
    # If a future lean-boot ever provisions a real credential, this needs a redaction pass
    # before it keeps printing. Reviewed as safe TODAY, not in principle.
    # REDACTED, because an argument in a comment is not a control. The Codex seat on
    # PR# 759 - tap made that point directly: the safety case for printing these logs
    # existed only in prose while the code echoed unconditionally. This is the prose
    # turned into code.
    #
    # Honest about what it is: a pattern masker, not a guarantee. It catches the shapes
    # a credential usually arrives in — an assignment whose key looks secret-ish, a
    # Bearer header, a PEM block header, a postgres URL's password field. It cannot
    # catch a secret that looks like ordinary text, and nothing that greps can.
    #
    # What makes the residual acceptable HERE is the surrounding context rather than the
    # regex: lean-boot's only credential is the throwaway admin password generated at the
    # top of this script — which is now generated unconditionally rather than inherited,
    # precisely so this sentence stays true no matter what the caller exports. tap_secrets/
    # is empty, there is no customer data, and TAP's logging contract
    # (spec-tap-logging.md) keeps credential-shaped values out of logs at the source.
    #
    # Three holes in the first version of this masker, all found by the Codex seat on
    # PR# 759 - tap and ALL THREE reproduced before fixing (RAN 2026-09-22):
    #
    #   "password": "hunter2"   JSON form — the key is followed by `"`, not by `[=:]`
    #   PASSWORD = value        whitespace around the delimiter was not allowed for
    #   -----BEGIN … KEY-----   sed is line-based, so `.*` masked only the BEGIN line
    #   MIIEowIBAAKCAQEA…       and every base64 body line printed in full
    #
    # The first two are fixed by allowing an optional quote around the key and
    # whitespace around the delimiter; the third needs a line RANGE, not a substitution,
    # because the body is on different lines than the marker.
    _redact() {
      sed -E \
        -e '/-----BEGIN [A-Z ]*PRIVATE KEY-----/,/-----END [A-Z ]*PRIVATE KEY-----/{
              /-----(BEGIN|END) [A-Z ]*PRIVATE KEY-----/!s/.*/***REDACTED-KEY-BODY***/
            }' \
        -e 's/("?(TOKEN|SECRET|PASSWORD|PASSWD|APIKEY|API_KEY|CREDENTIAL|PRIVATE_KEY|ACCESS_KEY)[A-Z_]*"?[[:space:]]*[=:][[:space:]]*)("[^"]*"|[^[:space:],}]+)/\1***REDACTED***/Ig' \
        -e 's/(Bearer|Basic)[[:space:]]+[A-Za-z0-9._~+\/-]+=*/\1 ***REDACTED***/Ig' \
        -e 's/(:\/\/[^:@[:space:]]+:)[^@[:space:]]+@/\1***REDACTED***@/g'
    }
    echo "### web logs (tail 200) — throwaway stack, credential-shaped values masked"
    printf '%s\n' "$web_out" | _redact
    echo
    info "post-mortem: run the /diagnose-failed-session-spawn skill"
  fi
  # Linux CI: files the CONTAINER wrote into the bind-mounted worktree (logs/boot
  # records) are root-owned on a Linux host — the invoking user cannot rm them, so
  # teardown fails AFTER a green gate (observed on GHA runners 2026-08-10). Remove
  # container-written paths from inside a container first; on macOS Docker Desktop
  # uid-maps writes, so this is a harmless no-op. Uses the already-pulled published
  # image; never fails the gate.
  docker run --rm -v "$WORKTREE:/w" --entrypoint sh \
    ghcr.io/unified-systems-com/tap-web:latest -c 'rm -rf /w/logs' >/dev/null 2>&1 || true
  bold "Tearing down throwaway '$NAME'"
  if ! WORKTREE_BASE="$WORKTREE_BASE" scripts/despawn-session.sh "$NAME" --yes >/dev/null 2>&1; then
    # despawn couldn't do it (e.g. spawn died before the worktree existed) — nuke by hand.
    docker compose -p "$PROJECT" down -v --remove-orphans >/dev/null 2>&1 || true
    git worktree remove --force "$WORKTREE" >/dev/null 2>&1 || rm -rf "$WORKTREE"
    git branch -D "session/$NAME" >/dev/null 2>&1 || true
  fi
  exit "$rc"
}
trap teardown EXIT INT TERM

# Idempotent pre-clean: torch any leftover from a prior aborted run so spawn's
# name/branch/worktree collision guards don't false-fail.
WORKTREE_BASE="$WORKTREE_BASE" scripts/despawn-session.sh "$NAME" --yes >/dev/null 2>&1 || true

# Pre-warm the throwaway build's base images so a slow registry can't time the
# `docker compose build` OUT from under a healthy tree. A DeadlineExceeded pulling
# `ghcr.io/astral-sh/uv:latest` INSIDE the timed build once red-flagged a clean
# tree as an "import leak" (2026-07-03) — the build failed before Python ran. The
# image list is parsed from the Dockerfile so it can't drift; a failed pre-pull only
# warns (the build still tries over the network).
bold "Pre-warming base images (so the timed build hits local cache, not the network)"
while IFS= read -r img; do
  [[ -z "$img" ]] && continue
  if docker image inspect "$img" >/dev/null 2>&1; then
    info "cached: $img"
  elif docker pull "$img" >/dev/null 2>&1; then
    info "pulled: $img"
  else
    info "WARN: pre-pull failed for $img (build will retry over the network)"
  fi
done < <(grep -oE '^(FROM [^ ]+|COPY --from=[^ ]+)' Dockerfile | sed -E 's/^FROM +//; s/^COPY --from=//' | grep -E '[/:]' | sort -u)

bold "Lean-boot independence gate — spawning throwaway '$NAME'"
info "profile=$PROFILE (isolated core-only venv)   worktree_base=$WORKTREE_BASE"
scripts/spawn-session.sh "$NAME" --boot "$PROFILE"

bold "LEAN-BOOT GREEN"
info "'$PROFILE' booted healthy in an isolated core-only venv — no plugin-only import leaked into the core boot path."
