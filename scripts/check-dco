#!/usr/bin/env bash
# scripts/check-dco — DCO Signed-off-by trailer check (ONE artifact, MANY invokers).
#
# Verifies every commit this branch would add to the base ref carries a
# `Signed-off-by:` trailer (CONTRIBUTING "Sign-Off"). Exempt, per that policy:
#   * merge commits (DCO convention; the promote's pre-push merges stay clean)
#   * every commit in the range of a pull request whose AUTHENTICATED author is an
#     approved bot identity — a maintainer certifies those at merge, normally by
#     squash-merging with their own sign-off
#
# THE BOT EXEMPTION IS KEYED OFF AUTHORITY, NEVER OFF THE COMMIT'S AUTHOR STRING
# (tap#335). Until 2026-09-18 this script matched `(renovate|dependabot|…)\[bot\]`
# against `%an <%ae>` — text the committer sets. `git -c user.name='renovate[bot]'
# commit` therefore produced a commit the DCO gate waved through. The DCO certifies
# that a HUMAN has the right to contribute the code, so a bypass does not merely
# skip a CI step: it puts a claim in the record that a person certified work they
# never saw. The decision now comes from GitHub's own view of who opened the pull
# request (`github.event.pull_request.user.{id,type}`, passed by the `dco` job as
# `--pr-author-id/--pr-author-type/--pr-author`) and is derived ONCE, in
# scripts/pr_bot_identity.py, shared with scripts/check-issue-link. Read that file
# before "simplifying" the check back to a string match.
#
# Where no authenticated identity exists — a local promote (no PR yet) and a
# `merge_group` event (no `pull_request.user`) — NOTHING is exempt. Fail-closed in
# both directions: the server's `dco` job is the authoritative verdict (required
# through the `gate` aggregator since tap#353), and the local lane is strictly
# stricter than it, never quieter. Named consequence: an unsigned bot commit carried
# into a HUMAN's branch is now a red, because a human's PR is not the bot's PR — bot
# changes land on the bot's own pull request.
#
# ENFORCING since 2026-08-12, when CONTRIBUTING.md + DCO landed at the repo root
# as approved policy (req-cicd-dco-signoff-3). A violation is a non-zero exit:
# it reds the `dco` CI job and aborts a promote. The default lives HERE rather
# than in the invokers on purpose — an ad-hoc `scripts/check-dco` gives the same
# verdict CI will, so the artifact can never be quietly less strict than the gate.
# Escape hatch: TAP_DCO_REPORT_ONLY=1 (lists violations, exits 0) for triaging a
# pile of unsigned history without blocking the run.
#
# Invokers: scripts/promote-to-main.sh (local gates) and the `dco` job in
# .github/workflows/product-lines.yml (the PR road + the promote's dispatched
# cloud gate). The trailer itself is applied by .githooks/prepare-commit-msg.
#
# Spec: specs/spec-cicd-hardening.md (req-cicd-dco-signoff).
#
# Usage:
#   scripts/check-dco                        # check merge-base(origin/main, HEAD)..HEAD
#   scripts/check-dco <base-ref>             # explicit base ref
#   scripts/check-dco --pr-author-id <n> --pr-author-type <type> --pr-author <login> [<base-ref>]
#                                            # CI: exempt the range iff <n> is an approved Bot identity
#   TAP_DCO_REPORT_ONLY=1 scripts/check-dco  # list violations without failing

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$(git rev-parse --show-toplevel)"

info() { printf "    %s\n" "$1"; }
warn() { printf "\033[33m    WARN: %s\033[0m\n" "$1" >&2; }
fail() { printf "\033[31m    ERROR: %s\033[0m\n" "$1" >&2; exit 1; }

# --- Authenticated pull-request identity (optional; CI only). Empty on every other road.
PR_AUTHOR_ID=""
PR_AUTHOR_TYPE=""
PR_AUTHOR_LOGIN=""
# Plain scalars, no arrays: this runs under `#!/usr/bin/env bash`, which on macOS is
# still bash 3.2, where `${#arr[@]}` on an empty array trips `set -u`.
BASE_REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pr-author-id)   [ $# -ge 2 ] || fail "--pr-author-id needs a value";   PR_AUTHOR_ID="$2";    shift 2 ;;
    --pr-author-type) [ $# -ge 2 ] || fail "--pr-author-type needs a value"; PR_AUTHOR_TYPE="$2";  shift 2 ;;
    --pr-author)      [ $# -ge 2 ] || fail "--pr-author needs a value";      PR_AUTHOR_LOGIN="$2"; shift 2 ;;
    *) [ -z "$BASE_REF" ] || fail "unexpected argument: $1"; BASE_REF="$1"; shift ;;
  esac
done
BASE_REF="${BASE_REF:-origin/main}"

git rev-parse --verify --quiet "$BASE_REF" >/dev/null \
  || fail "Base ref '$BASE_REF' not found (shallow clone? fetch first: git fetch origin main)."

RANGE="$(git merge-base "$BASE_REF" HEAD)..HEAD"

# --- The ONE exemption: an approved bot's pull request (CONTRIBUTING "Sign-Off": an
# automated system must not certify the DCO; the merging maintainer certifies instead).
#
# The decision is not made here — it is derived once in scripts/pr_bot_identity.py from
# GitHub's authenticated `pull_request.user`, shared with scripts/check-issue-link. This
# script only asks. With no identity passed (a local run, a merge_group event) it does not
# even ask: nothing is exempt, and no interpreter is needed on that road.
if [ -n "$PR_AUTHOR_ID$PR_AUTHOR_TYPE$PR_AUTHOR_LOGIN" ]; then
  command -v python3 >/dev/null 2>&1 \
    || fail "an authenticated PR identity was passed but python3 is not on PATH — cannot decide the bot exemption (fail-closed)."
  set +e
  exemption="$(python3 "$SCRIPT_DIR/pr_bot_identity.py" \
    --pr-author-id "$PR_AUTHOR_ID" --pr-author-type "$PR_AUTHOR_TYPE" --pr-author "$PR_AUTHOR_LOGIN" 2>&1)"
  exemption_rc=$?
  set -e
  case "$exemption_rc" in
    0) info "DCO check SKIPPED — $exemption"; exit 0 ;;
    1) info "no bot exemption: $exemption" ;;
    # Exit 2 is a malformed/unreadable allowlist: a configuration error, never a silent pass.
    *) fail "$exemption" ;;
  esac
fi

# --- Pass 1: individual remediation declarations (CONTRIBUTING "Sign-Off").
#
# A later commit may retroactively certify an earlier one, so an unsigned commit
# is fixable WITHOUT rewriting history — which matters on a shared branch, where
# `--amend`/`rebase` would break someone else's work. Format and identity rules
# follow the reference DCO app (dcoapp/app) verbatim so a contributor who knows
# the ecosystem convention needs no TAP-specific knowledge:
#
#   I, Ada Lovelace <ada@example.com>, hereby add my Signed-off-by to this commit: <sha>
#
# Accepted only when ALL hold — the declaration certifies the declarer's OWN
# earlier work, never someone else's:
#   * the remediation commit itself carries a Signed-off-by trailer
#   * the declared identity == the remediation commit's own author
#   * the declared identity == the target commit's author (checked in pass 2)
#
# THIRD-PARTY remediation ("On behalf of X, I, Y, hereby add...") is deliberately
# NOT accepted: certifying another person's right to submit is a materially
# larger statement than certifying your own, and enabling it is a policy call for
# the steward, not a mechanical convenience.
REMEDIATED=""
while read -r sha; do
  [ -n "$sha" ] || continue
  git log -1 --format='%(trailers:key=Signed-off-by,valueonly)' "$sha" | grep -q . || continue
  r_author="$(git log -1 --format='%an <%ae>' "$sha")"
  while IFS= read -r line; do
    if [[ "$line" =~ ^I,\ (.+)\ \<(.+)\>,\ hereby\ add\ my\ Signed-off-by\ to\ this\ commit:\ ([0-9a-fA-F]{7,40})[[:space:]]*$ ]]; then
      claim="${BASH_REMATCH[1]} <${BASH_REMATCH[2]}>"
      target="${BASH_REMATCH[3]}"
      if [ "$(printf '%s' "$claim" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$r_author" | tr '[:upper:]' '[:lower:]')" ]; then
        warn "ignoring remediation in $(git log -1 --format='%h' "$sha"): declared '$claim' but the commit is authored by '$r_author'"
        continue
      fi
      REMEDIATED="${REMEDIATED}${target}|${claim}
"
    fi
  done <<< "$(git log -1 --format='%B' "$sha")"
done < <(git rev-list --no-merges "$RANGE")

# True when $1 (a full sha) is remediated by a declaration whose identity also
# matches $2 (that commit's author). Target shas may be abbreviated, so prefix-match.
is_remediated() {
  local sha="$1" author_lc t c
  author_lc="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
  while IFS='|' read -r t c; do
    [ -n "$t" ] || continue
    case "$sha" in
      "$t"*) [ "$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')" = "$author_lc" ] && return 0 ;;
    esac
  done <<< "$REMEDIATED"
  return 1
}

violations=0
checked=0
while read -r sha; do
  [ -n "$sha" ] || continue
  # No author-string exemption lives here on purpose (tap#335): `%an <%ae>` is text the
  # committer sets, so it can claim anything. It is read only to match a remediation
  # declaration against the identity it certifies.
  author="$(git log -1 --format='%an <%ae>' "$sha")"
  checked=$((checked + 1))
  if ! git log -1 --format='%(trailers:key=Signed-off-by,valueonly)' "$sha" | grep -q .; then
    if is_remediated "$sha" "$author"; then
      info "remediated: $(git log -1 --format='%h %s' "$sha") — certified by a later remediation commit"
      continue
    fi
    warn "missing Signed-off-by: $(git log -1 --format='%h %s (%an)' "$sha")"
    violations=$((violations + 1))
  fi
done < <(git rev-list --no-merges "$RANGE")

if [ "$violations" -eq 0 ]; then
  info "DCO check GREEN — $checked commit(s) checked, all signed (merge commits exempt)."
  exit 0
fi

if [ "${TAP_DCO_REPORT_ONLY:-0}" = "1" ]; then
  warn "DCO report-only (TAP_DCO_REPORT_ONLY=1): $violations of $checked commit(s) missing Signed-off-by."
  exit 0
fi

# Remediation is spelled out, not implied: the single-commit and whole-branch
# forms differ, and a contributor meeting this red for the first time should not
# have to derive the rebase incantation. Both re-write history, so they are safe
# on an unmerged branch and wrong on a shared one — hence the force-with-lease note.
printf "\033[31m    ERROR: DCO check RED — %s of %s commit(s) missing Signed-off-by.\033[0m\n" "$violations" "$checked" >&2
cat >&2 <<EOF
    Fix A — remediation commit (keeps history; safe on a SHARED branch).
      Add an empty commit whose message certifies the earlier one(s), one line each:
        git commit -s --allow-empty -m "I, \$(git config user.name) <\$(git config user.email)>, hereby add my Signed-off-by to this commit: <sha>"
      The declared identity must match both your own and the target commit's author.
    Fix B — rewrite (simpler, but only on a branch nobody else has pulled;
      force-push with --force-with-lease after):
      last commit only : git commit --amend --no-edit -s
      whole branch     : git rebase --exec 'git commit --amend --no-edit -s' $BASE_REF
    Sign-off is your certification under the DCO — see CONTRIBUTING.md "Sign-Off".
    Future commits are stamped automatically by .githooks/prepare-commit-msg
    (active when core.hooksPath=.githooks — set by scripts/spawn-session.sh; a
    plain clone needs 'git commit -s' or 'git config core.hooksPath .githooks').
EOF
exit 1
