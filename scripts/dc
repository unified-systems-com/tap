#!/usr/bin/env bash
# Thin docker-compose wrapper that cascades .env and .env.local so
# per-worktree overrides layer on top of checked-in defaults.
#
# Usage: scripts/dc <any docker compose subcommand>
# Examples:
#   scripts/dc up
#   scripts/dc exec web uv run python manage.py migrate
#
# See spec-dev-multisession.md for the multi-session dev setup this enables.

set -euo pipefail

# The validation block sits ABOVE the `cd` deliberately: `--selftest-user` must run where
# `git rev-parse` cannot (inside the container, where the bind mount's ownership makes git
# refuse), or the guard that exercises it can never call it.

# Resolve TAP_USER the way COMPOSE will, then refuse a root-valued one.
#
# The first version of this check read only the shell environment, and the Codex seat on
# PR# 759 - tap found two ways past it. Both were REPRODUCED before this was rewritten:
#
#   TAP_USER=00:0 scripts/dc ps            -> exit 0. The check compared strings, and "00"
#                                             is not "0", but Docker reads it as uid 0.
#   TAP_USER=0:0 in .env.local             -> `scripts/dc config` resolved
#                                             services.web.user = '0:0'. This is the
#                                             SUPPORTED configuration path and the shell-only
#                                             check never saw it at all.
#
# So resolution comes first and the comparison is numeric. Compose precedence: the shell
# environment wins over env files, and a later --env-file wins over an earlier one.
_tap_user_resolve() {
  local v="${TAP_USER:-}"
  if [[ -z "$v" && -f .env.local ]]; then v="$(sed -n 's/^[[:space:]]*TAP_USER=//p' .env.local | tail -1)"; fi
  if [[ -z "$v" && -f .env ]];       then v="$(sed -n 's/^[[:space:]]*TAP_USER=//p' .env       | tail -1)"; fi
  # Strip surrounding quotes BEFORE comparing. Compose strips them; a check that does not
  # is comparing a different string than the one that takes effect — which is how
  # TAP_USER="0:0" in .env.local resolved to services.web.user = '0:0' while this script
  # said it had refused it. Found by the Codex seat on PR# 759 - tap, round four, and
  # reproduced before the fix.
  printf '%s' "$v"
}

_tap_user_check() {
  local v="$1" uid
  # Normalise HERE, in the deciding function, so every caller gets the same answer.
  # A previous version normalised only in _tap_user_resolve, and the selftest — which
  # calls this directly — was therefore comparing a different string than the env-file
  # path did. Compose strips quotes; so does this.
  v="${v//[[:space:]]/}"
  v="${v#[\"\']}"
  v="${v%[\"\']}"
  [[ -z "$v" ]] && return 0
  uid="${v%%:*}"
  # Numeric comparison, so 0, 00 and 000 are all uid 0. `10#` forces base 10 so a leading
  # zero is not read as octal.
  if [[ "$uid" =~ ^[0-9]+$ ]] && (( 10#$uid == 0 )); then
    echo "scripts/dc: refusing TAP_USER=${v} — uid 0 defeats the point of the override." >&2
    echo "            The web image runs as a non-root user; this key aligns it with YOUR uid." >&2
    return 1
  fi
  if [[ "$uid" == "root" ]]; then
    echo "scripts/dc: refusing TAP_USER=${v} — 'root' is uid 0." >&2
    return 1
  fi
  return 0
}

# Exposed so it can be EXERCISED rather than grepped for. The previous test searched this
# file for the word "root", which would have passed with the check deleted — the same
# vacuous-assertion shape the repo's own guards hunt.
if [[ "${1:-}" == "--selftest-user" ]]; then
  _tap_user_check "${2:-}"
  exit $?
fi


cd "$(git rev-parse --show-toplevel)"

# The container user (tap#754). The web image runs unprivileged; the dev stack additionally
# runs it as THIS host user, because the container writes into the `.:/app` bind mount (boot
# record, snapshot, pytest caches) and on Linux those writes are refused unless the uid owns
# the tree. Exported here rather than written into .env.local so it can never go stale
# against the account actually running the stack, and so every worktree gets it for free.
# macOS does not need it (Docker Desktop maps ownership on the bind mount) and gets it
# anyway — one code path, and the one a Linux developer runs is then the one that was
# exercised locally. The GID stays at compose's default of 0; see docker-compose.yml.
# The container uid, for bind-mount writability on Linux. DELIBERATELY NOT DEFAULTED:
# the published image's volume mountpoints are still root-owned, so forcing a uid here
# breaks any stack that pulls it (proved by lean-boot on PR# 759 - tap). The image's own
# `USER nonroot` is what makes the container unprivileged; this only aligns uids. Export
# TAP_USER yourself to opt in, and make it the default once the new image is published.
_TAP_USER_RESOLVED="$(_tap_user_resolve)"
_tap_user_check "$_TAP_USER_RESOLVED" || exit 1
[[ -n "${TAP_USER:-}" ]] && export TAP_USER

args=()
[[ -f .env ]] && args+=(--env-file .env)
[[ -f .env.local ]] && args+=(--env-file .env.local)

# The base compose file is pull-only (a missing pinned tag must hard-fail `up`,
# never silently build — see docker-compose.build.yml). The `build` subcommand
# is the explicit opt-in: stack the build overlay so `scripts/dc build web`
# keeps working exactly as documented.
if [[ "${1:-}" == "build" ]]; then
  args+=(-f docker-compose.yml -f docker-compose.build.yml)
fi

# AUTHORITATIVE root check, against what COMPOSE RESOLVES rather than what was typed.
#
# The string check above is a fast first pass with a helpful message. It is NOT the
# boundary, and SIX separate escapes proved that inspecting the input is structurally
# the wrong place to stand — each one was reproduced before being fixed:
#
#   TAP_USER=00:0              string compare; "00" != "0", Docker reads uid 0
#   TAP_USER=0:0 in .env.local the check read only the shell environment
#   TAP_USER="0:0"             compose strips quotes, the check did not
#   TAP_USER=${U:-0}:0         compose INTERPOLATES; the apparent uid is "${U" and
#                              compose resolves it to 0:0
#   export TAP_USER=0:0        compose's dotenv accepts the `export ` prefix; the
#                              grep that decided whether to RUN this check did not
#   TAP_USER = 0:0             compose's dotenv trims whitespace around the key; the
#                              same grep anchored on `TAP_USER=` and missed it
#
# Every one of those is the same mistake: validating a value before the thing that
# transforms it. So this asks compose what it actually produced. `config` is the only
# answer that cannot be spelled around, because it IS the resolution.
#
# THIS CHECK IS UNCONDITIONAL, and escapes five and six are why. It used to run only
# when a `grep -qE '^[[:space:]]*TAP_USER='` found the key in the environment or an
# env-file — which made a string inspection of the input the gate on the authoritative
# check. That is the identical mistake the check exists to correct, moved up one level:
# both bypasses above defeated the grep, so the authoritative check never ran at all
# and `services.web.user` resolved to '0:0' with exit 0. RAN 2026-09-22 on b3cdda0b,
# both reproduced, then re-run against this version and refused.
# Found by the Codex seat on PR# 759 - tap, round five.
#
# The conditional bought 0.28s on the ordinary path (RAN: `docker compose config
# --format json` on this repo). That is not worth a class of bypass we have now paid
# for six times, so there is no longer a fast path to get wrong.
# ESCAPE SEVEN, found by the Codex seat against the FIRST version of this unconditional
# check — i.e. against the fix for escapes five and six, one round later. It was written:
#
#   _resolved_user="$(docker compose … | python3 -c '…' 2>/dev/null || echo "__UNRESOLVED__")"
#
# `set -o pipefail` is on (line 12). So when compose exits nonzero, the PIPELINE status is
# nonzero even though python ran fine and printed its answer — and `||` then APPENDS a
# second sentinel instead of replacing the value. The result is neither a uid nor the exact
# sentinel:
#
#   RAN: compose emits invalid JSON and exits 3  ->  _resolved_user="__UNRESOLVED____UNRESOLVED__"
#        which != "__UNRESOLVED__", so the fail-closed branch NEVER FIRED, and
#        _tap_user_check saw a non-numeric string, returned 0, and scripts/dc exec'd.
#
# A fail-closed branch that can be stepped around is not fail-closed. The lesson is the same
# one as escapes 1-6 wearing different clothes: the value was transformed (by pipefail, this
# time) after being produced and before being compared.
#
# So: capture the command's output and its status SEPARATELY, never inferring one from a
# pipeline, and treat anything that is not a single well-formed user spec as unresolved.
_compose_json=""
if ! _compose_json="$(docker compose "${args[@]}" config --format json 2>/dev/null)"; then
  _compose_json=""
fi

if [[ -z "$_compose_json" ]]; then
  _resolved_user="__UNRESOLVED__"
elif ! _resolved_user="$(printf '%s' "$_compose_json" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("services", {}).get("web", {}).get("user", "") or "")
except Exception:
    sys.exit(1)' 2>/dev/null)"; then
  _resolved_user="__UNRESOLVED__"
fi

# Anything multi-line, or not shaped like a user spec, is a value we cannot reason about —
# and "cannot reason about" is exactly the case escape seven walked through. An empty string
# is legitimate and means "no user: key, use the image's USER".
if [[ "$_resolved_user" == *$'\n'* ]] \
   || { [[ -n "$_resolved_user" ]] \
        && [[ ! "$_resolved_user" =~ ^[A-Za-z0-9_.-]+(:[A-Za-z0-9_.-]+)?$ ]]; }; then
  _resolved_user="__UNRESOLVED__"
fi

if [[ "$_resolved_user" == "__UNRESOLVED__" ]]; then
  # FAIL CLOSED. Falling back to the string check would be falling back to the thing
  # that was defeated six times; a config we cannot resolve is one we cannot vouch for.
  # Compose's own error is surfaced because an unreadable config is usually a broken
  # compose file, not an attack, and the reader needs to see which.
  echo "scripts/dc: the resolved compose config could not be read, so the container's" >&2
  echo "            uid cannot be verified. Refusing rather than guessing. Compose said:" >&2
  # `|| true` because this is a DIAGNOSTIC, and under `set -e` + `pipefail` its nonzero
  # status would terminate the script here with compose's exit code instead of reaching
  # the `exit 1` below. Still a refusal either way, but the code should be the one we chose.
  { docker compose "${args[@]}" config 2>&1 >/dev/null | sed 's/^/            /' >&2; } || true
  exit 1
fi
if ! _tap_user_check "$_resolved_user"; then
  echo "            (that is the value COMPOSE RESOLVED, not the one you typed)" >&2
  exit 1
fi

exec docker compose "${args[@]}" "$@"
