#!/usr/bin/env bash
# Thin docker-compose wrapper that cascades .env and .env.local so
# per-worktree overrides layer on top of checked-in defaults.
#
# Usage: scripts/dc <any docker compose subcommand>
# Examples:
#   scripts/dc up
#   scripts/dc exec web uv run python manage.py migrate
#
# See spec-dev-multisession.md for the multi-session dev setup this enables.

set -euo pipefail

# The validation block sits ABOVE the `cd` deliberately: `--selftest-user` must run where
# `git rev-parse` cannot (inside the container, where the bind mount's ownership makes git
# refuse), or the guard that exercises it can never call it.

# Resolve TAP_USER the way COMPOSE will, then refuse a root-valued one.
#
# The first version of this check read only the shell environment, and the Codex seat on
# PR# 759 - tap found two ways past it. Both were REPRODUCED before this was rewritten:
#
#   TAP_USER=00:0 scripts/dc ps            -> exit 0. The check compared strings, and "00"
#                                             is not "0", but Docker reads it as uid 0.
#   TAP_USER=0:0 in .env.local             -> `scripts/dc config` resolved
#                                             services.web.user = '0:0'. This is the
#                                             SUPPORTED configuration path and the shell-only
#                                             check never saw it at all.
#
# So resolution comes first and the comparison is numeric. Compose precedence: the shell
# environment wins over env files, and a later --env-file wins over an earlier one.
_tap_user_resolve() {
  local v="${TAP_USER:-}"
  if [[ -z "$v" && -f .env.local ]]; then v="$(sed -n 's/^[[:space:]]*TAP_USER=//p' .env.local | tail -1)"; fi
  if [[ -z "$v" && -f .env ]];       then v="$(sed -n 's/^[[:space:]]*TAP_USER=//p' .env       | tail -1)"; fi
  printf '%s' "${v//[[:space:]]/}"
}

_tap_user_check() {
  local v="${1//[[:space:]]/}" uid
  [[ -z "$v" ]] && return 0
  uid="${v%%:*}"
  # Numeric comparison, so 0, 00 and 000 are all uid 0. `10#` forces base 10 so a leading
  # zero is not read as octal.
  if [[ "$uid" =~ ^[0-9]+$ ]] && (( 10#$uid == 0 )); then
    echo "scripts/dc: refusing TAP_USER=${v} — uid 0 defeats the point of the override." >&2
    echo "            The web image runs as a non-root user; this key aligns it with YOUR uid." >&2
    return 1
  fi
  if [[ "$uid" == "root" ]]; then
    echo "scripts/dc: refusing TAP_USER=${v} — 'root' is uid 0." >&2
    return 1
  fi
  return 0
}

# Exposed so it can be EXERCISED rather than grepped for. The previous test searched this
# file for the word "root", which would have passed with the check deleted — the same
# vacuous-assertion shape the repo's own guards hunt.
if [[ "${1:-}" == "--selftest-user" ]]; then
  _tap_user_check "${2:-}"
  exit $?
fi


cd "$(git rev-parse --show-toplevel)"

# The container user (tap#754). The web image runs unprivileged; the dev stack additionally
# runs it as THIS host user, because the container writes into the `.:/app` bind mount (boot
# record, snapshot, pytest caches) and on Linux those writes are refused unless the uid owns
# the tree. Exported here rather than written into .env.local so it can never go stale
# against the account actually running the stack, and so every worktree gets it for free.
# macOS does not need it (Docker Desktop maps ownership on the bind mount) and gets it
# anyway — one code path, and the one a Linux developer runs is then the one that was
# exercised locally. The GID stays at compose's default of 0; see docker-compose.yml.
# The container uid, for bind-mount writability on Linux. DELIBERATELY NOT DEFAULTED:
# the published image's volume mountpoints are still root-owned, so forcing a uid here
# breaks any stack that pulls it (proved by lean-boot on PR# 759 - tap). The image's own
# `USER nonroot` is what makes the container unprivileged; this only aligns uids. Export
# TAP_USER yourself to opt in, and make it the default once the new image is published.
_TAP_USER_RESOLVED="$(_tap_user_resolve)"
_tap_user_check "$_TAP_USER_RESOLVED" || exit 1
[[ -n "${TAP_USER:-}" ]] && export TAP_USER

args=()
[[ -f .env ]] && args+=(--env-file .env)
[[ -f .env.local ]] && args+=(--env-file .env.local)

# The base compose file is pull-only (a missing pinned tag must hard-fail `up`,
# never silently build — see docker-compose.build.yml). The `build` subcommand
# is the explicit opt-in: stack the build overlay so `scripts/dc build web`
# keeps working exactly as documented.
if [[ "${1:-}" == "build" ]]; then
  args+=(-f docker-compose.yml -f docker-compose.build.yml)
fi

exec docker compose "${args[@]}" "$@"
