#!/usr/bin/env bash
# Thin docker-compose wrapper that cascades .env and .env.local so
# per-worktree overrides layer on top of checked-in defaults.
#
# Usage: scripts/dc <any docker compose subcommand>
# Examples:
#   scripts/dc up
#   scripts/dc exec web uv run python manage.py migrate
#
# See spec-dev-multisession.md for the multi-session dev setup this enables.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The container user (tap#754). The web image runs unprivileged; the dev stack additionally
# runs it as THIS host user, because the container writes into the `.:/app` bind mount (boot
# record, snapshot, pytest caches) and on Linux those writes are refused unless the uid owns
# the tree. Exported here rather than written into .env.local so it can never go stale
# against the account actually running the stack, and so every worktree gets it for free.
# macOS does not need it (Docker Desktop maps ownership on the bind mount) and gets it
# anyway — one code path, and the one a Linux developer runs is then the one that was
# exercised locally. The GID stays at compose's default of 0; see docker-compose.yml.
# The container uid, for bind-mount writability on Linux. DELIBERATELY NOT DEFAULTED:
# the published image's volume mountpoints are still root-owned, so forcing a uid here
# breaks any stack that pulls it (proved by lean-boot on PR# 759 - tap). The image's own
# `USER nonroot` is what makes the container unprivileged; this only aligns uids. Export
# TAP_USER yourself to opt in, and make it the default once the new image is published.
[[ -n "${TAP_USER:-}" ]] && export TAP_USER

args=()
[[ -f .env ]] && args+=(--env-file .env)
[[ -f .env.local ]] && args+=(--env-file .env.local)

# The base compose file is pull-only (a missing pinned tag must hard-fail `up`,
# never silently build — see docker-compose.build.yml). The `build` subcommand
# is the explicit opt-in: stack the build overlay so `scripts/dc build web`
# keeps working exactly as documented.
if [[ "${1:-}" == "build" ]]; then
  args+=(-f docker-compose.yml -f docker-compose.build.yml)
fi

exec docker compose "${args[@]}" "$@"
