#!/usr/bin/env bash
# Gryphon executor branch-coverage ratchet.
#
# Runs the executor-exercising test suites under coverage.py *branch*
# instrumentation and fails if `tap_grid/gryphon/executor.py` branch coverage
# regresses below the committed floor. This is the branch-level complement to the
# stage-coverage gate (`req-gridkin-stage-coverage`): the stage gate proves every
# dispatch *path* runs with a WHERE; this proves the executor's *branches* stay
# exercised, catching an unexercised branch *within* a stage (the finer grain the
# intent≠path-coverage AAR §7 asked for).
#
# It is deliberately NOT a per-commit pytest gate: coverage.py must wrap the whole
# test process, and the instrumented run of the full executor corpus takes ~10-15
# min. It is a script — run on-demand and, once the dev-validation promote gate
# lands (`spec-dev-validation.md` `req-dev-validation-smoke-gate`), from there.
# Its honest guard status is tracked in that spec's Validation Map.
#
# Usage (must run INSIDE the compose web container — needs pytest, the DB, and the
# `coverage` dev dep):
#   scripts/dc exec -T web scripts/gryphon-coverage-ratchet
#
# Ratchets UP: when coverage improves, bump `executor_branch_pct_floor` in the
# baseline file to lock in the gain (the script prints the reminder).

set -euo pipefail

cd "$(git rev-parse --show-toplevel 2>/dev/null || echo /app)"

BASELINE_FILE="tap_grid/gryphon/coverage-baseline.json"
COV_JSON="/tmp/gryphon-coverage.json"

# The gridkin corpus ships in the `gryphon_playground` plugin (tap#370), collected by
# dotted path through the installed package — the same road plugin-ci takes. A missing
# plugin is a refusal: a floor measured without the corpus would ratchet DOWN on the
# next honest run, and the whole point is measuring across the corpus.
if [ -z "$(uv run python -c "from tap.plugin_testing import plugin_package_dir as p; print(p('gryphon_playground') or '', end='')")" ]; then
    echo "FAIL: tap_plugin.gryphon_playground is not installed — the gridkin corpus ships in that plugin." >&2
    echo "      Boot a profile that installs it (core_ci, test_all) or \`spawn --dev-plugins gryphon_playground\`." >&2
    exit 2
fi

# The suites that exercise the executor. The floor is measured over their union,
# so a branch reached only by a gridkin scenario (as the envelope-WHERE branch
# was) counts as covered — the whole point of measuring across the corpus.
# `--pyargs` lets the dotted corpus module and the core file paths share one run.
SUITES=(
  tap_grid/tests/test_gryphon.py
  tap_grid/tests/test_gryphon_sql_capture.py
  tap_plugin.gryphon_playground.tests.test_gridkin
  tap_api/tests/test_gryphon.py
)

echo "==> Running executor-exercising suites under coverage.py (branch)..."
uv run coverage run --branch --source=tap_grid.gryphon.executor -m pytest -p no:cacheprovider --pyargs "${SUITES[@]}" -q
uv run coverage json -o "$COV_JSON" >/dev/null

uv run python - "$BASELINE_FILE" "$COV_JSON" <<'PY'
import json
import sys

from tap.ratchet import RatchetError, ratchet_floor

baseline_path, cov_path = sys.argv[1], sys.argv[2]
baseline = json.load(open(baseline_path, encoding="utf-8"))
cov = json.load(open(cov_path, encoding="utf-8"))

# Match by suffix so the ratchet is robust to how coverage keys the file.
files = cov["files"]
try:
    key = next(k for k in files if k.replace("\\", "/").endswith("tap_grid/gryphon/executor.py"))
except StopIteration:
    sys.exit("FAIL: no coverage data for tap_grid/gryphon/executor.py — did the run collect data?")

summary = files[key]["summary"]
num_branches = summary["num_branches"]
covered_branches = summary["covered_branches"]
# Pure branch coverage — covered / total branches — so "branch coverage" is
# literally what is ratcheted (not coverage.py's combined line+branch percent).
current = 100.0 * covered_branches / num_branches if num_branches else 100.0
floor = baseline["executor_branch_pct_floor"]

print(
    f"executor.py branch coverage: current={current:.2f}% (floor {int(current)}%)  "
    f"ratchet floor={floor}%  "
    f"[{covered_branches}/{num_branches} branches]"
)

# Compare-and-report is the shared harness core (tap.ratchet.ratchet_floor):
# int-floored regression raises; an improvement returns a bump reminder. The
# surface-specific "add a gridkin scenario" hint is appended to a regression.
try:
    bump = ratchet_floor(
        current=current,
        floor=floor,
        surface="Gryphon executor branch coverage",
        baseline_path=baseline_path,
    )
except RatchetError as exc:
    print(
        f"FAIL: {exc}\n"
        "  Prefer a gridkin scenario that exercises the newly-uncovered branch (so the\n"
        "  answer is oracle-checked too). Deliberate code removal → lower the floor with a reason."
    )
    sys.exit(1)

if bump is not None:
    print(f"NOTE: {bump}\n  (the floor key is `executor_branch_pct_floor`).")
print("OK: executor branch coverage holds at or above the ratchet floor.")
PY
