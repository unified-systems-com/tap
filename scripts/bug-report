#!/usr/bin/env bash
# scripts/bug-report -- the commands behind the submit-a-bug skill (specs/spec-dev-bug-reporting.md).
#
# Every subcommand is a fixed verb of tap/bug_report.py run in the web container; nothing here
# evals, interpolates a report's text into a command, or takes a flag the skill did not name.
# Report files live only in .bug-reports/ (gitignored). The three verbs that touch GitHub run on the
# host, with the operator's own gh login:
#
#   search REPO QUERY   numbers, titles, URLs and states of matching issues (route-4)
#   issue REPO NUMBER   one issue's title and body, read as data: hidden text stripped, instruction-shaped
#                       lines reported, exit 2 when there are any (investigate-3)
#   send FILE           gh issue create --body-file FILE, once, and never retried (consent-1..4)
#
# The host facts passed to the container (user, home, hostname, OS, architecture, Docker version) are
# DENY-LIST entries: a report may not carry them unless it lists one as evidence (disclosure-2).
#
# Usage: scripts/bug-report <component|route|observe|render|check|search-query|search|issue|preview|consent|send|finish> ...
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mkdir -p .bug-reports

dc_py() { scripts/dc exec -T web uv run python -m tap.bug_report "$@"; }
host_flags=(
  --host-user "${USER:-}" --host-home "${HOME:-}" --host-name "$(hostname)"
  --host-fact "$(uname -s)" --host-fact "$(uname -m)"
  --host-fact "$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo unknown)"
  --host-fact "$(docker compose version --short 2>/dev/null || echo unknown)"
)
repo_re='^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$'
number_re='^[0-9]{1,9}$'
file_ok() { [[ "$1" == .bug-reports/* && "$1" != *..* && -f "$1" ]]; }

cmd="${1:-}"
[[ -n "$cmd" ]] || { sed -n '2,17p' "$0" >&2; exit 2; }
shift

case "$cmd" in
  component|route|observe|consent|finish)
    dc_py "$cmd" "$@"
    ;;
  render|check|preview|search-query)
    dc_py "$cmd" "$@" "${host_flags[@]}"
    ;;
  search)
    repo="${1:-}"; query="${2:-}"; shift 2 || true
    [[ "$repo" =~ $repo_re ]] || { echo "bug-report: repository must be a plain owner/name" >&2; exit 2; }
    # The query is outbound before any consent: it must pass the tripwire first (route-4).
    dc_py search-query "$query" "$@" "${host_flags[@]}"
    exec gh issue list --repo "$repo" --state all --limit 20 --json number,title,url,state --search "$query"
    ;;
  issue)
    repo="${1:-}"; number="${2:-}"
    [[ "$repo" =~ $repo_re ]] || { echo "bug-report: repository must be a plain owner/name" >&2; exit 2; }
    [[ "$number" =~ $number_re ]] || { echo "bug-report: issue number must be digits" >&2; exit 2; }
    # Fetched to a file under .bug-reports/, then read as data by the container (investigate-3).
    gh api "repos/$repo/issues/$number" > ".bug-reports/read-$number.json"
    dc_py read-issue ".bug-reports/read-$number.json"
    ;;
  send)
    file="${1:-}"; shift || true
    file_ok "$file" || { echo "bug-report: send takes an existing file under .bug-reports/" >&2; exit 2; }
    # Tripwire, valid report and a consent recorded for exactly these bytes, or no send.
    repo="$(dc_py verify-send "$file" --print repository "$@" "${host_flags[@]}")"
    title="$(dc_py verify-send "$file" --print title "$@" "${host_flags[@]}")"
    [[ "$repo" =~ $repo_re ]] || { echo "bug-report: refusing a repository that is not a plain owner/name" >&2; exit 1; }
    label_args=()
    if gh label list --repo "$repo" --limit 200 --json name --jq '.[].name' 2>/dev/null | grep -Fxq 'via:submit-a-bug'; then
      label_args=(--label 'via:submit-a-bug')
      echo "label via:submit-a-bug exists in $repo and will be applied"
    else
      echo "label via:submit-a-bug does not exist in $repo; the issue is created without it (this skill does not create labels)"
    fi
    # Screenshots: each was checked for type and size and is bound into the consent hash.
    attach_args=()
    while IFS= read -r line; do
      [[ -n "$line" ]] && attach_args+=(--attach "$line")
    done <<< "$(dc_py verify-send "$file" --print attachments "$@" "${host_flags[@]}")"
    # Capture the help text first: `grep -q` exiting early would SIGPIPE gh and fail the pipeline under pipefail.
    # Only when there are screenshots to attach: a report without them makes exactly one gh call.
    if [[ ${#attach_args[@]} -gt 0 ]]; then
      create_help="$(gh issue create --help 2>/dev/null || true)"
      if ! grep -q -- '--attach' <<< "$create_help"; then
        echo "bug-report: the installed gh does not support 'gh issue create --attach' (observed in gh 2.100.0). Nothing was sent. Upgrade gh, or send without screenshots." >&2
        exit 1
      fi
    fi
    out_file="$(mktemp)"; err_file="$(mktemp)"
    trap 'rm -f "$out_file" "$err_file"' EXIT
    # One attempt. A failure is shown as it came and nothing else is tried (consent-4).
    if gh issue create --repo "$repo" --title "$title" --body-file "$file" ${label_args[@]+"${label_args[@]}"} ${attach_args[@]+"${attach_args[@]}"} >"$out_file" 2>"$err_file"; then
      cat "$out_file"; cat "$err_file" >&2
    else
      url="$(grep -E '^https://github\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/issues/[0-9]+$' "$out_file" | head -1 || true)"
      if [[ -n "$url" ]]; then
        # Partial failure: GitHub created the issue and some attachment failed. Never a second issue.
        echo "bug-report: the issue WAS created, but some attachments failed: $url" >&2
        cat "$out_file"
        echo "gh said (verbatim):" >&2
        cat "$err_file" >&2
        echo "Nothing else was tried and no second issue was created. Add the missing images by editing the issue yourself." >&2
      else
        cat "$out_file"; cat "$err_file" >&2
        echo "" >&2
        echo "bug-report: gh issue create failed (output above, verbatim). Nothing else was tried." >&2
        echo "Offered instead: keep the report locally in $file, or open https://github.com/$repo/issues/new and paste it yourself." >&2
      fi
      exit 1
    fi
    ;;
  *)
    echo "bug-report: unknown subcommand '$cmd'" >&2
    exit 2
    ;;
esac
