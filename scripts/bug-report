#!/usr/bin/env bash
# scripts/bug-report -- the commands behind the submit-a-bug skill (specs/spec-dev-bug-reporting.md).
#
# Every subcommand is a fixed verb of tap/bug_report.py run in the web container; nothing here
# evals, interpolates a report's text into a command, or takes a flag the skill did not name.
# Report files live only in .bug-reports/ (gitignored). The verbs that touch GitHub run on the
# host, with the operator's own gh login:
#
#   search REPO QUERY   numbers, titles, URLs and states of matching issues (route-4)
#   issue REPO NUMBER   one issue's title and body, piped into the container and read as data: hidden
#                       text stripped, instruction-shaped lines reported, exit 2 when there are any;
#                       nothing unsanitised is written to disk (investigate-3)
#   send FILE           gh issue create --body-file FILE, once, and never retried (consent-1..4)
#
# Consent is the reporter's act, so it is taken HERE, on the host, from a terminal, and recorded
# OUTSIDE the worktree (consent-5): `consent FILE` refuses input that is not a TTY, and `send`
# refuses a file with no record for exactly its bytes. Neither the container nor an agent's
# granted tools can write that directory. A send spends the record (consent-7) and sends from a
# snapshot outside the worktree whose bytes are re-hashed against the verified manifest, so what gh
# reads is what was verified and consented to (consent-1).
#
# The host facts passed to the container (user, home, hostname, OS, architecture, Docker version) are
# DENY-LIST entries: a report may not carry them unless it lists one as evidence (disclosure-2).
#
# Usage: scripts/bug-report <component|route|observe|render|check|search-query|search|issue|preview|consent|send|finish> ...
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mkdir -p .bug-reports

dc_py() { scripts/dc exec -T web uv run python -m tap.bug_report "$@"; }
host_flags=(
  --host-user "${USER:-}" --host-home "${HOME:-}" --host-name "$(hostname)"
  --host-fact "$(uname -s)" --host-fact "$(uname -m)"
  --host-fact "$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo unknown)"
  --host-fact "$(docker compose version --short 2>/dev/null || echo unknown)"
)
consent_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tap-bug-reports/consent"
repo_re='^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$'
number_re='^[0-9]{1,9}$'
file_ok() { [[ "$1" == .bug-reports/* && "$1" != *..* && -f "$1" ]]; }
out_ok() { [[ "$1" == .bug-reports/* && "$1" != *..* && "$1" != */ ]]; }
# The digest the typed yes names: the report's bytes plus every attachment's, computed in the container.
digest_of() { dc_py digest "$1" | python3 -c 'import json,sys; print(json.load(sys.stdin)["digest"])'; }

cmd="${1:-}"
[[ -n "$cmd" ]] || { sed -n '2,22p' "$0" >&2; exit 2; }
shift

case "$cmd" in
  component|route|observe)
    dc_py "$cmd" "$@"
    ;;
  check|preview|search-query)
    dc_py "$cmd" "$@" "${host_flags[@]}"
    ;;
  render)
    answers="${1:-}"; out="${2:-}"; shift 2 || true
    file_ok "$answers" || { echo "bug-report: render takes an answers file under .bug-reports/" >&2; exit 2; }
    out_ok "$out" || { echo "bug-report: render writes only under .bug-reports/" >&2; exit 2; }
    # The container prints the report; the file is written here, whole or not at all.
    tmp="$(mktemp .bug-reports/.render.XXXXXX)"
    if dc_py render "$answers" "$@" "${host_flags[@]}" > "$tmp"; then
      mv "$tmp" "$out"
      echo "wrote $out"
    else
      rm -f "$tmp"
      exit 1
    fi
    ;;
  search)
    repo="${1:-}"; query="${2:-}"; shift 2 || true
    [[ "$repo" =~ $repo_re ]] || { echo "bug-report: repository must be a plain owner/name" >&2; exit 2; }
    # The query is outbound before any consent: it must pass the tripwire first (route-4).
    dc_py search-query "$query" "$@" "${host_flags[@]}"
    exec gh issue list --repo "$repo" --state all --limit 20 --json number,title,url,state --search "$query"
    ;;
  issue)
    repo="${1:-}"; number="${2:-}"
    [[ "$repo" =~ $repo_re ]] || { echo "bug-report: repository must be a plain owner/name" >&2; exit 2; }
    [[ "$number" =~ $number_re ]] || { echo "bug-report: issue number must be digits" >&2; exit 2; }
    # Piped straight into the container's intake: the raw body never lands on disk (investigate-3).
    gh api "repos/$repo/issues/$number" | dc_py read-issue -
    ;;
  consent)
    file="${1:-}"
    file_ok "$file" || { echo "bug-report: consent takes an existing file under .bug-reports/" >&2; exit 2; }
    if [[ ! -t 0 ]]; then
      echo "bug-report: consent is typed by the reporter at a terminal. Input that is not a terminal (a pipe, a file, an agent's shell) is refused, and nothing was recorded." >&2
      exit 1
    fi
    digest="$(digest_of "$file")"
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || { echo "bug-report: could not compute the report's digest" >&2; exit 1; }
    phrase="yes ${digest:0:12}"
    echo "To send exactly these bytes of $file, type: $phrase"
    printf '> '
    IFS= read -r typed
    if [[ "$typed" != "$phrase" ]]; then
      echo "bug-report: consent not recorded: the yes must be exactly '$phrase' for these bytes" >&2
      exit 1
    fi
    mkdir -p "$consent_dir"
    printf '%s\n%s\n' "$file" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$consent_dir/$digest"
    echo "consent recorded for sha256 $digest (outside the worktree, in $consent_dir)"
    ;;
  send)
    file="${1:-}"; shift || true
    file_ok "$file" || { echo "bug-report: send takes an existing file under .bug-reports/" >&2; exit 2; }
    # One verification in the container: a block render would accept, no hidden text, tripwire clean,
    # our repository, and a manifest naming every file's bytes by sha256 plus the digest the yes names.
    manifest="$(dc_py verify-send "$file" "$@" "${host_flags[@]}")"
    IFS=$'\t' read -r repo digest title < <(python3 -c 'import json,sys; m=json.load(sys.stdin); print(m["repository"], m["digest"], m["title"].replace("\t", " "), sep="\t")' <<< "$manifest")
    [[ "$repo" =~ $repo_re ]] || { echo "bug-report: refusing a repository that is not a plain owner/name" >&2; exit 1; }
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || { echo "bug-report: could not read the report's digest" >&2; exit 1; }
    # A yes typed at a terminal for exactly these bytes, or no send (consent-2, consent-5).
    if [[ ! -f "$consent_dir/$digest" ]]; then
      echo "bug-report: no consent typed at a terminal for these bytes: the reporter runs 'scripts/bug-report consent $file' in their own terminal first (a changed file needs a new yes)" >&2
      exit 1
    fi
    # Snapshot the verified bytes OUTSIDE the worktree, where neither the container nor the agent's
    # granted tools can reach them, and re-hash the copies against the manifest before gh reads anything.
    snap="$(mktemp -d "${TMPDIR:-/tmp}/tap-bug-send.XXXXXX")"
    out_file="$(mktemp)"; err_file="$(mktemp)"
    trap 'rm -rf "$snap" "$out_file" "$err_file"' EXIT
    body=""; attach_args=()
    while IFS=$'\t' read -r path sha alt; do
      [[ -n "$path" ]] || continue
      file_ok "$path" || { echo "bug-report: manifest names a file outside .bug-reports/: $path" >&2; exit 1; }
      cp "$path" "$snap/$(basename "$path")"
      copied="$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$snap/$(basename "$path")")"
      [[ "$copied" == "$sha" ]] || { echo "bug-report: $path changed between verification and the send; nothing was sent. Preview it again and take a new yes." >&2; exit 1; }
      if [[ -z "$body" ]]; then body="$snap/$(basename "$path")"; else attach_args+=(--attach "$snap/$(basename "$path")#$alt"); fi
    done < <(python3 -c 'import json,sys; [print(f["path"], f["sha256"], f["alt"], sep="\t") for f in json.load(sys.stdin)["files"]]' <<< "$manifest")
    [[ -n "$body" ]] || { echo "bug-report: the manifest named no report" >&2; exit 1; }
    # The yes is spent by this send, success or failure: a second send needs a new yes (consent-7).
    rm -f "$consent_dir/$digest"
    label_args=()
    if gh label list --repo "$repo" --limit 200 --json name --jq '.[].name' 2>/dev/null | grep -Fxq 'via:submit-a-bug'; then
      label_args=(--label 'via:submit-a-bug')
      echo "label via:submit-a-bug exists in $repo and will be applied"
    else
      echo "label via:submit-a-bug does not exist in $repo; the issue is created without it (this skill does not create labels)"
    fi
    # Capture the help text first: `grep -q` exiting early would SIGPIPE gh and fail the pipeline under pipefail.
    # Only when there are screenshots to attach: a report without them makes exactly one gh call.
    if [[ ${#attach_args[@]} -gt 0 ]]; then
      create_help="$(gh issue create --help 2>/dev/null || true)"
      if ! grep -q -- '--attach' <<< "$create_help"; then
        echo "bug-report: the installed gh does not support 'gh issue create --attach' (observed in gh 2.100.0). Nothing was sent. Upgrade gh, or send without screenshots." >&2
        exit 1
      fi
    fi
    # One attempt. A failure is shown as it came and nothing else is tried (consent-4).
    if gh issue create --repo "$repo" --title "$title" --body-file "$body" ${label_args[@]+"${label_args[@]}"} ${attach_args[@]+"${attach_args[@]}"} >"$out_file" 2>"$err_file"; then
      cat "$out_file"; cat "$err_file" >&2
    else
      url="$(grep -E '^https://github\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/issues/[0-9]+$' "$out_file" | head -1 || true)"
      if [[ -n "$url" ]]; then
        # Partial failure: GitHub created the issue and some attachment failed. Never a second issue.
        echo "bug-report: the issue WAS created, but some attachments failed: $url" >&2
        cat "$out_file"
        echo "gh said (verbatim):" >&2
        cat "$err_file" >&2
        echo "Nothing else was tried and no second issue was created. Add the missing images by editing the issue yourself." >&2
      else
        cat "$out_file"; cat "$err_file" >&2
        echo "" >&2
        echo "bug-report: gh issue create failed (output above, verbatim). Nothing else was tried." >&2
        echo "Offered instead: keep the report locally in $file, or open https://github.com/$repo/issues/new and paste it yourself." >&2
      fi
      exit 1
    fi
    ;;
  finish)
    # Nothing local outlives the skill: the observed-values file in the container's view, the consent records here (tripwire-6).
    dc_py finish
    if [[ -d "$consent_dir" ]]; then
      n="$(find "$consent_dir" -type f | wc -l | tr -d ' ')"
      rm -f "$consent_dir"/*
      echo "removed $n consent record(s) from $consent_dir"
    fi
    ;;
  *)
    echo "bug-report: unknown subcommand '$cmd'" >&2
    exit 2
    ;;
esac
