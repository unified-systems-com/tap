#!/usr/bin/env python3
"""Requirement Burndown Dashboard — render (and optionally publish) the living issue.

The Renovate Dependency-Dashboard pattern applied to the traceability campaign
(`specs/spec-tap-requirement-traceability.md` §Definition of Done): ONE pinned
GitHub issue, wholly regenerated from the corpus derivations in `tap.spec_trace`,
never hand-edited. Run it after a triage batch lands on main.

Usage:
    scripts/burndown-dashboard              # print the rendered body to stdout
    scripts/burndown-dashboard --update     # create-or-update the GitHub issue (gh CLI)

Stdlib-only and host-runnable (tap.spec_trace is deliberately Django-free).
Every number is derived on the spot — this script stores nothing and decides
nothing; `tap/spec_trace.py` owns the buckets, this file owns the prose.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from datetime import date
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from tap.spec_trace import (  # noqa: E402
    _zero_acid_kind,
    accounting,
    collect_evidence,
    load_corpus,
    unaccounted_rids,
    zero_acid_built,
)

ISSUE_TITLE = "Requirement Burndown Dashboard"
ISSUE_MARKER = "<!-- tap-burndown-dashboard -->"
# Where the campaign started when the Definition of Done was declared
# (2026-08-20, pre-wave measurement) — the fixed origin the progress % is
# computed against. Not derived: it is a historical fact, not a tree fact.
CAMPAIGN_ORIGIN_UNACCOUNTED = 1072


def render() -> str:
    corpus = load_corpus(REPO_ROOT)
    buckets = accounting(REPO_ROOT)
    evidence = collect_evidence(REPO_ROOT)
    un = unaccounted_rids(REPO_ROOT)
    zero_acid = zero_acid_built(REPO_ROOT)
    exempt_zero_acid = sum(1 for req in corpus.requirements.values() if _zero_acid_kind(req) == "exempt")

    total = len(corpus.requirements)
    counts: dict[str, int] = {}
    for bucket in buckets.values():
        counts[bucket] = counts.get(bucket, 0) + 1

    claims_total = sum(len(e.implemented_by) for e in evidence.values())
    dual = sum(1 for e in evidence.values() if e.implemented_by and e.verified_acids)

    drained = CAMPAIGN_ORIGIN_UNACCOUNTED - len(un)
    pct = 100 * drained // CAMPAIGN_ORIGIN_UNACCOUNTED

    per_spec: dict[str, int] = {}
    for rid in un:
        spec = corpus.requirements[rid].spec_path.relative_to(REPO_ROOT).as_posix()
        per_spec[spec] = per_spec.get(spec, 0) + 1

    filled = pct * 20 // 100
    bar = "█" * filled + "░" * (20 - filled)

    lines = [
        ISSUE_MARKER,
        "",
        "The living scoreboard for the requirement↔code traceability campaign — the",
        "Definition of Done is **every requirement mapped or documented-excluded**",
        "(`specs/spec-tap-requirement-traceability.md`). Wholly regenerated by",
        "`scripts/burndown-dashboard --update`; do not hand-edit.",
        "",
        f"## Progress: {bar} {pct}%",
        "",
        f"**{len(un)} Unaccounted** of a {CAMPAIGN_ORIGIN_UNACCOUNTED}-requirement campaign origin "
        f"({drained} drained). Corpus today: **{total}** requirements — "
        f"{counts.get('mapped', 0)} mapped · {counts.get('excluded', 0)} excluded · "
        f"{counts.get('doctrine', 0)} doctrine · {counts.get('disputed', 0)} disputed · "
        f"{counts.get('unbuilt', 0)} unbuilt · {counts.get('retired', 0)} retired.",
        "",
        f"Evidence: **{claims_total}** implementation claims · **{dual}** requirements carry both",
        f"evidence classes (claim + test-cited ACID) · **{len(zero_acid)}** built with zero ACIDs",
        f"(payable debt) · **{exempt_zero_acid}** zero-ACID among the excluded (exempt per",
        "`req-tap-traceability-acid-floor-3`; reasons per-RID in the fragments' Exclusions sections).",
        "",
        "## Remaining Unaccounted, by spec",
        "",
        "| Spec | Unaccounted |",
        "| --- | ---: |",
    ]
    for spec, n in sorted(per_spec.items(), key=lambda kv: (-kv[1], kv[0])):
        lines.append(f"| `{spec}` | {n} |")
    lines += [
        "",
        "## How a requirement drains",
        "",
        "Run the `/triage-requirements` skill (`tap/skills/triage-requirements/SKILL.md`) on a",
        "spec batch: fix the status, mint a `TAP-IMPLEMENTS` claim or a `@pytest.mark.spec`",
        "test marker, or document the exclusion with a `Trace:` disposition. The Unaccounted",
        "ratchet enforces shrink-only; per-spec detail lives in the committed fragments at",
        "`specs/traceability/<spec>.md`, and the corpus-wide table derives on demand via",
        "`manage.py guards --accounting`.",
        "",
        f"_Regenerated {date.today().isoformat()} from `git {git_head()}`._",
    ]
    return "\n".join(lines)


def git_head() -> str:
    return subprocess.run(
        ["git", "rev-parse", "--short", "HEAD"], cwd=REPO_ROOT, capture_output=True, text=True, check=True
    ).stdout.strip()


def update_issue(body: str) -> None:
    """Create the dashboard issue if absent, else overwrite its body."""
    found = subprocess.run(
        ["gh", "issue", "list", "--state", "open", "--search", f'in:title "{ISSUE_TITLE}"', "--json", "number,title"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
        check=True,
    )
    import json

    numbers = [row["number"] for row in json.loads(found.stdout) if row["title"] == ISSUE_TITLE]
    # Overwrite only an issue this script authored: the marker comment must already be
    # in the body (Codex-seat finding on PR #114 — title match alone could clobber a
    # retitled or pre-existing issue). Scan EVERY title match for the marker rather
    # than judging only the first (Codacy follow-up: a collision ahead of the real
    # dashboard must not make updates go inert).
    for number in numbers:
        existing = subprocess.run(
            ["gh", "issue", "view", str(number), "--json", "body", "--jq", ".body"],
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            check=True,
        ).stdout
        if ISSUE_MARKER not in existing:
            continue
        subprocess.run(
            ["gh", "issue", "edit", str(number), "--body", body], cwd=REPO_ROOT, capture_output=True, check=True
        )
        print(f"updated issue #{number}")
        return
    if numbers:
        print(
            f"{len(numbers)} issue(s) match the title but none carries {ISSUE_MARKER!r} — "
            f"refusing to overwrite; creating nothing (rename or close the impostor first).",
            file=sys.stderr,
        )
        return
    else:
        created = subprocess.run(
            ["gh", "issue", "create", "--title", ISSUE_TITLE, "--body", body],
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            check=True,
        )
        print(f"created {created.stdout.strip()}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Render or publish the Requirement Burndown Dashboard issue.")
    parser.add_argument("--update", action="store_true", help="create or update the GitHub issue via gh")
    args = parser.parse_args()
    body = render()
    if args.update:
        update_issue(body)
    else:
        print(body)
    return 0


if __name__ == "__main__":
    sys.exit(main())
