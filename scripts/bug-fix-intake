#!/usr/bin/env bash
# scripts/bug-fix-intake -- the one fetch behind the submit-a-fix skill (specs/spec-dev-bug-reporting.md).
#
# Fetches ONE issue and its comments from a unified-systems-com repository, but only after the
# issue's AUTHOR has been checked as a maintainer session account, by numeric id and type
# (req-dev-bugfix-ownreports). The author is read through a filter that drops the body, so for any
# other author the body is never fetched, never written to disk, and never reaches the session.
# The fetched text is then read as data by tap/bug_report.py: invisible characters, HTML comments
# and collapsed blocks stripped and counted, comments from other accounts not read, and anything
# that reads like an instruction reported as a finding.
#
# Version 0 has no sandbox: this script does not claim the session that runs it holds no
# credential and no network (req-dev-bugfix-isolation is Backlog).
#
# Usage: scripts/bug-fix-intake unified-systems-com/<repo> <issue-number>
# Exit:  0 report read, nothing flagged | 1 stopped (author or malformed report) | 2 findings, human decides
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mkdir -p .bug-reports

repo="${1:-}"; number="${2:-}"
[[ "$repo" =~ ^unified-systems-com/[A-Za-z0-9_.-]+$ ]] || { echo "bug-fix-intake: repository must be unified-systems-com/<name>" >&2; exit 2; }
[[ "$number" =~ ^[0-9]{1,9}$ ]] || { echo "bug-fix-intake: issue number must be digits" >&2; exit 2; }

dc_py() { scripts/dc exec -T web uv run python -m tap.bug_report "$@"; }

# 1. Author only. The jq filter keeps three fields; the body stays inside gh.
if ! gh api "repos/$repo/issues/$number" --jq '{id: .user.id, type: .user.type, login: .user.login}' | dc_py gate-author >&2; then
  echo "bug-fix-intake: STOP. The issue body was not fetched." >&2
  exit 1
fi

# 2. The author is a maintainer session account: now the body and the comments.
gh api "repos/$repo/issues/$number" > ".bug-reports/issue-$number.json"
gh api --paginate --slurp "repos/$repo/issues/$number/comments" > ".bug-reports/issue-$number.comments.json"

# 3. Read as data.
dc_py intake ".bug-reports/issue-$number.json" ".bug-reports/issue-$number.comments.json"
