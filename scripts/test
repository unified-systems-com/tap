#!/usr/bin/env bash
# scripts/test — run the TAP test suite inside the compose image, parallelized.
#
# Parallelism lives here, NOT in pyproject `addopts`, on purpose: `-n auto` adds a
# per-worker DB-build tax that penalizes small/single-test runs (~4s serial vs ~15s
# under -n auto, measured). So the DEFAULT `pytest` stays serial (best for
# single-test debugging), and the parallel lanes are explicit.
#
# Lanes (req-dev-validation-suite-tiers; docs/misc/test-parallelization-xdist-notes.md):
#   scripts/test            DEFAULT lane, -n auto, RELEVANCE-GATED on the gryphon
#                           corpus (req-dev-validation-suite-tiers-5): runs the
#                           corpus only when the diff since origin/main touches the
#                           executor footprint, else skips it with a loud notice.
#                           Non-interactive (piped/CI/promote) or an unresolvable
#                           merge-base => RUNS the corpus (fail toward correctness),
#                           so a gate never inherits a skip.
#   scripts/test --gryphon  FULL lane — force the gryphon corpus ON unconditionally.
#                           What the promote gate invokes (~9 min). The gryphon
#                           executor stage/branch-coverage guards ride this corpus.
#   scripts/test --fast     INNER-LOOP lane — -n auto minus the gryphon corpus
#                           (~7-18 min of scenarios), unconditionally. NOT a gate: a
#                           local accelerator, so it skips the gryphon guards, which
#                           the full lane still runs (req-dev-validation-suite-tiers-4).
#   scripts/test --fast-relevant  The PROMOTE lane: core walk + the corpus when the diff touches
#                           the executor footprint, and NO other plugin suite (tap#1092).
#   scripts/test --fast-relevant --plugins a,b [--no-core]   ALSO run those installed plugin suites
#                           (`auto` = the suites this diff can reach: imports + declared pins).
#                           (--no-core: skip the core walk, just those suites).
#   scripts/test --stop     Stop the run holding this stack's pytest lock (whole process group).
#   scripts/test <args...>  Extra args pass through to pytest, e.g.
#                           scripts/test tap_auth -k login
#                           scripts/test --fast tap_web
#
# For single-test debugging prefer bare (serial) pytest — no worker/DB startup tax:
#   scripts/dc exec web uv run pytest tap/tests/test_x.py::test_y

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# --- Gryphon corpus: force-on/off flags, else relevance-gate ------------------
# The corpus (the gryphon_playground plugin's shipped tests) dominates the clock. It
# exercises the Cypher->SQL executor, which compiles onto shared grid machinery — so
# the footprint that "means the corpus must run" is conservative (errs toward
# running; a false SKIP would be a silent-wrong-result false-green). Narrowing
# tap_grid/ to the executor's true import set is a later optimization.
#
# Since the eviction the corpus lives INSIDE the installed plugin package (a
# site-packages wheel or an editable checkout), which the repo-root walk never
# descends into — so it is collected only by naming its tests dir explicitly
# (`tap.plugin_testing`, the one seam that knows where installed plugin tests are),
# and skipped simply by not naming it. The monorepo path (`plugins/<slug>`, under the
# repo root) was retired 2026-09-09 (tap#364). The plugin's own repo runs the corpus on its
# cadence; here it runs when the executor footprint is touched or on --gryphon.
GRYPHON_CORPUS_SLUG="gryphon_playground"
GRYPHON_FOOTPRINT_RE='^(tap_grid/|tap_api/routers/gryphon\.py)'

# `--stop` kills the run holding this stack's pytest lock (its whole process group), then exits.
if [[ "${1:-}" == "--stop" ]]; then
  exec scripts/dc exec -T web uv run python -m tap.pytest_lock stop
fi

gryphon_mode=""  # "", "on" (force-run), "off" (force-skip via --fast), "relevance" (--fast-relevant)
if [[ "${1:-}" == "--gryphon" ]]; then
  gryphon_mode="on"
  shift
elif [[ "${1:-}" == "--fast" ]]; then
  gryphon_mode="off"
  shift
elif [[ "${1:-}" == "--fast-relevant" ]]; then
  # The promote lane (#254): fast, EXCEPT the corpus runs when the diff touches
  # the executor footprint. Same relevance gate as the interactive default —
  # explicitly requested, so it applies even when non-interactive. Exists so an
  # executor-touching promote gets its corpus verdict locally, before push,
  # instead of ten minutes later from the cloud gate as a failed round-trip.
  gryphon_mode="relevance"
  shift
fi

# `--plugins a,b` (with --fast-relevant only): ALSO run these installed plugin suites on the scoped
# lane; add `--no-core` for JUST those suites (and the corpus when relevant), under the lock. For a core change a plugin's own tests pin (tap_web / tap_viz behaviour), and for plugin
# repos that have no CI of their own. A slug that is not installed is a red, not a skip.
extra_plugins=()
no_core=0
while [[ "${1:-}" == "--plugins" || "${1:-}" == --plugins=* || "${1:-}" == "--no-core" ]]; do
  if [[ "$gryphon_mode" != "relevance" ]]; then
    echo "scripts/test: ${1%%=*} applies to --fast-relevant only (the other lanes already run what they run)." >&2
    exit 2
  fi
  if [[ "$1" == "--no-core" ]]; then
    no_core=1; shift
  else
    if [[ "$1" == --plugins=* ]]; then plugin_list="${1#--plugins=}"; shift; else plugin_list="${2:-}"; shift $(( $# > 1 ? 2 : 1 )); fi
    IFS=',' read -r -a plugin_slugs <<< "$plugin_list"
    extra_plugins+=(${plugin_slugs[@]+"${plugin_slugs[@]}"})
  fi
done

# `--plugins auto`: add the installed plugin suites this diff can reach, derived from each plugin's
# imports of the changed core code plus the surfaces its tests declare they pin (tap/impacted_plugins.py,
# req-dev-validation-suite-tiers-8). The reasons print; explicit slugs are kept alongside.
named_plugins=()
want_auto=0
for slug in ${extra_plugins[@]+"${extra_plugins[@]}"}; do
  if [[ "$slug" == "auto" ]]; then want_auto=1; else named_plugins+=("$slug"); fi
done
if [[ "$want_auto" -eq 1 ]]; then
  auto_base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
  if [[ -z "$auto_base" ]]; then
    echo "scripts/test: --plugins auto needs a merge-base with origin/main to know what changed." >&2
    exit 2
  fi
  auto_changed="$( { git diff --name-only "$auto_base"; git ls-files --others --exclude-standard; } | sort -u )"
  auto_found="$(printf '%s\n' "$auto_changed" | scripts/dc exec -T web uv run python -m tap.impacted_plugins)"
  while IFS= read -r slug; do
    [[ -n "$slug" ]] && named_plugins+=("$slug")
  done <<< "$auto_found"
fi
extra_plugins=(${named_plugins[@]+"${named_plugins[@]}"})

if [[ "$no_core" -eq 1 && ${#extra_plugins[@]} -eq 0 ]]; then
  # --no-core means "just these plugin suites". With none named the corpus may still be added by the
  # relevance gate below, but an empty lane must never be a green one.
  echo "scripts/test: --no-core needs at least one plugin suite: --plugins <slug>, or --plugins auto when the diff reaches one (otherwise the lane could run no tests and still exit 0)." >&2
  exit 2
fi

# Decide whether to run the corpus.
run_gryphon=1
if [[ "$gryphon_mode" == "on" ]]; then
  run_gryphon=1
elif [[ "$gryphon_mode" == "off" ]]; then
  run_gryphon=0
  echo "gryphon corpus SKIPPED (--fast): local accelerator, not a gate." >&2
elif [[ "$gryphon_mode" == "" && ! -t 1 ]]; then
  # Non-interactive with NO explicit mode (piped / CI) — never auto-skip a gate.
  # Fail toward correctness. --fast-relevant falls through: it asked for the
  # relevance gate by name, so being non-interactive does not force-include.
  run_gryphon=1
  echo "gryphon corpus INCLUDED (non-interactive run — gates never auto-skip)." >&2
else
  # Relevance gate on the diff vs origin/main: the interactive default, and the
  # explicit --fast-relevant promote lane.
  base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
  if [[ -z "$base" ]]; then
    run_gryphon=1
    echo "gryphon corpus INCLUDED (no merge-base with origin/main — fail toward correctness)." >&2
  else
    # Everything changed since the base: committed + staged + unstaged (git diff
    # against a commit spans the working tree) plus untracked files.
    changed="$( { git diff --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u )"
    hit="$(printf '%s\n' "$changed" | grep -E "$GRYPHON_FOOTPRINT_RE" | head -1 || true)"
    if [[ -n "$hit" ]]; then
      run_gryphon=1
      echo "gryphon corpus INCLUDED (relevance): diff touches the executor footprint (e.g. $hit)." >&2
    else
      run_gryphon=0
      echo "gryphon corpus SKIPPED (relevance): diff since origin/main does not touch the executor footprint." >&2
      echo "  footprint: tap_grid/ tap_api/routers/gryphon.py" >&2
      echo "  force it:  scripts/test --gryphon" >&2
    fi
  fi
fi

# TAP_TEST_JOBS caps xdist parallelism (default: auto). The pressure valve for a
# host running several TAP stacks at once: -n auto sizes workers by CPU count and
# ignores memory, and on a multi-stack Docker VM the OOM killer then reaps workers
# mid-run — the "node down: Not properly terminated" + cross-worker collection
# mismatch signature (observed 2026-08-09, five stacks / 7.75GiB VM). Resolved
# host-side, so it works through `dc exec` without env propagation.
pytest_args=(-n "${TAP_TEST_JOBS:-auto}")
# TAP_TEST_REUSE_DB=1 reuses each worker's test DB instead of rebuilding it (pytest-django --reuse-db):
# under load the per-worker DB build can dominate a small lane. Opt-in — drop it (or pass --create-db)
# after a migration or model change, or the lane runs against a stale schema.
if [[ "${TAP_TEST_REUSE_DB:-0}" == "1" ]]; then
  # Only the scoped promote lane and focused runs may reuse DBs: the full, --gryphon, --fast and bare
  # lanes are gates (or the promote's fallback authority) and always build a fresh schema.
  if [[ "$gryphon_mode" == "relevance" || $# -gt 0 ]]; then
    pytest_args+=(--reuse-db)
  else
    echo "scripts/test: TAP_TEST_REUSE_DB ignored — this lane is a gate and builds a fresh test DB." >&2
  fi
fi

# Allocate a TTY when run interactively (colours, live output); use -T when piped
# or run under automation (the promote gate) so it does not require one.
tty_args=()
[[ -t 1 ]] || tty_args=(-T)

# A FOCUSED invocation (any pass-through args: a path, a node id, -k, -m) goes straight
# to pytest — the developer named what to run. The WHOLE lane goes through the runner:
# `pytest <plugin dirs> /app` collects the core walk alone (pytest prunes a named path
# under an ignored/dot dir once the root is also an argument — tap#369), so the core walk
# and every installed plugin's suite run as separate invocations through the one seam
# (`tap.plugin_testing` → `tap.lane_run`), reported by owner. The corpus is the
# gryphon_playground suite: --gryphon REQUIRES it to execute, --fast EXCLUDES it, the
# relevance gate decides in between. An uninstalled corpus is a loud skip, never silent.
if [[ $# -gt 0 ]]; then
  exec scripts/dc exec "${tty_args[@]}" web sh -c \
    'cd /app && exec uv run python -m tap.pytest_lock run -- "$@"' _ "${pytest_args[@]}" "$@"
fi
lane_args=(--root /app)
[[ "$no_core" -eq 1 ]] && lane_args+=(--no-core)
if [[ "$run_gryphon" -eq 1 ]]; then
  lane_args+=(--require "$GRYPHON_CORPUS_SLUG")
else
  lane_args+=(--exclude "$GRYPHON_CORPUS_SLUG")
fi
# --fast-relevant is the promote's local lane and is SCOPED (tap#1092): the core walk, plus the
# corpus when the relevance gate chose it, and no other plugin suite. A plugin's own suite belongs
# to its repo's CI (plugins float; core_ci is fixtures-only), so running every installed one on a
# core promote cost tens of minutes in the shadow of the server gate. The other lanes keep theirs.
if [[ "$gryphon_mode" == "relevance" ]]; then
  only_slugs=(${extra_plugins[@]+"${extra_plugins[@]}"})
  [[ "$run_gryphon" -eq 1 ]] && only_slugs+=("$GRYPHON_CORPUS_SLUG")
  if [[ ${#only_slugs[@]} -gt 0 ]]; then
    for slug in "${only_slugs[@]}"; do lane_args+=(--only "$slug"); done
  else
    lane_args+=(--no-plugins)
  fi
fi
exec scripts/dc exec "${tty_args[@]}" web sh -c \
  'cd /app && exec uv run python -m tap.lane_run "$@"' _ "${lane_args[@]}" -- "${pytest_args[@]}"
