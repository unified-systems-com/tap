#!/usr/bin/env bash
# scripts/test — run the TAP test suite inside the compose image, parallelized.
#
# Parallelism lives here, NOT in pyproject `addopts`, on purpose: `-n auto` adds a
# per-worker DB-build tax that penalizes small/single-test runs (~4s serial vs ~15s
# under -n auto, measured). So the DEFAULT `pytest` stays serial (best for
# single-test debugging), and the parallel lanes are explicit.
#
# Lanes (req-dev-validation-suite-tiers; docs/misc/test-parallelization-xdist-notes.md):
#   scripts/test            DEFAULT lane, -n auto, RELEVANCE-GATED on the gryphon
#                           corpus (req-dev-validation-suite-tiers-5): runs the
#                           corpus only when the diff since origin/main touches the
#                           executor footprint, else skips it with a loud notice.
#                           Non-interactive (piped/CI/promote) or an unresolvable
#                           merge-base => RUNS the corpus (fail toward correctness),
#                           so a gate never inherits a skip.
#   scripts/test --gryphon  FULL lane — force the gryphon corpus ON unconditionally.
#                           What the promote gate invokes (~9 min). The gryphon
#                           executor stage/branch-coverage guards ride this corpus.
#   scripts/test --fast     INNER-LOOP lane — -n auto minus the gryphon corpus
#                           (~7-18 min of scenarios), unconditionally. NOT a gate: a
#                           local accelerator, so it skips the gryphon guards, which
#                           the full lane still runs (req-dev-validation-suite-tiers-4).
#   scripts/test <args...>  Extra args pass through to pytest, e.g.
#                           scripts/test tap_auth -k login
#                           scripts/test --fast tap_web
#
# For single-test debugging prefer bare (serial) pytest — no worker/DB startup tax:
#   scripts/dc exec web uv run pytest tap/tests/test_x.py::test_y

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# --- Gryphon corpus: force-on/off flags, else relevance-gate ------------------
# The corpus (plugins/gryphon_playground) dominates the clock. It exercises the
# Cypher->SQL executor, which compiles onto shared grid machinery — so the
# footprint that "means the corpus must run" is conservative (errs toward running;
# a false SKIP would be a silent-wrong-result false-green). Narrowing tap_grid/
# to the executor's true import set is a later optimization.
GRYPHON_CORPUS="plugins/gryphon_playground"
GRYPHON_FOOTPRINT_RE='^(tap_grid/|plugins/gryphon_playground/|plugins/grid_fixtures/|tap_api/routers/gryphon\.py)'

gryphon_mode=""  # "", "on" (force-run), "off" (force-skip via --fast), "relevance" (--fast-relevant)
if [[ "${1:-}" == "--gryphon" ]]; then
  gryphon_mode="on"
  shift
elif [[ "${1:-}" == "--fast" ]]; then
  gryphon_mode="off"
  shift
elif [[ "${1:-}" == "--fast-relevant" ]]; then
  # The promote lane (#254): fast, EXCEPT the corpus runs when the diff touches
  # the executor footprint. Same relevance gate as the interactive default —
  # explicitly requested, so it applies even when non-interactive. Exists so an
  # executor-touching promote gets its corpus verdict locally, before push,
  # instead of ten minutes later from the cloud gate as a failed round-trip.
  gryphon_mode="relevance"
  shift
fi

# Decide whether to run the corpus.
run_gryphon=1
if [[ "$gryphon_mode" == "on" ]]; then
  run_gryphon=1
elif [[ "$gryphon_mode" == "off" ]]; then
  run_gryphon=0
  echo "gryphon corpus SKIPPED (--fast): local accelerator, not a gate." >&2
elif [[ "$gryphon_mode" == "" && ! -t 1 ]]; then
  # Non-interactive with NO explicit mode (piped / CI) — never auto-skip a gate.
  # Fail toward correctness. --fast-relevant falls through: it asked for the
  # relevance gate by name, so being non-interactive does not force-include.
  run_gryphon=1
  echo "gryphon corpus INCLUDED (non-interactive run — gates never auto-skip)." >&2
else
  # Relevance gate on the diff vs origin/main: the interactive default, and the
  # explicit --fast-relevant promote lane.
  base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
  if [[ -z "$base" ]]; then
    run_gryphon=1
    echo "gryphon corpus INCLUDED (no merge-base with origin/main — fail toward correctness)." >&2
  else
    # Everything changed since the base: committed + staged + unstaged (git diff
    # against a commit spans the working tree) plus untracked files.
    changed="$( { git diff --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u )"
    hit="$(printf '%s\n' "$changed" | grep -E "$GRYPHON_FOOTPRINT_RE" | head -1 || true)"
    if [[ -n "$hit" ]]; then
      run_gryphon=1
      echo "gryphon corpus INCLUDED (relevance): diff touches the executor footprint (e.g. $hit)." >&2
    else
      run_gryphon=0
      echo "gryphon corpus SKIPPED (relevance): diff since origin/main does not touch the executor footprint." >&2
      echo "  footprint: tap_grid/ plugins/gryphon_playground/ plugins/grid_fixtures/ tap_api/routers/gryphon.py" >&2
      echo "  force it:  scripts/test --gryphon" >&2
    fi
  fi
fi

# TAP_TEST_JOBS caps xdist parallelism (default: auto). The pressure valve for a
# host running several TAP stacks at once: -n auto sizes workers by CPU count and
# ignores memory, and on a multi-stack Docker VM the OOM killer then reaps workers
# mid-run — the "node down: Not properly terminated" + cross-worker collection
# mismatch signature (observed 2026-08-09, five stacks / 7.75GiB VM). Resolved
# host-side, so it works through `dc exec` without env propagation.
pytest_args=(-n "${TAP_TEST_JOBS:-auto}")
[[ "$run_gryphon" -eq 0 ]] && pytest_args+=("--ignore=$GRYPHON_CORPUS")

# Allocate a TTY when run interactively (colours, live output); use -T when piped
# or run under automation (the promote gate) so it does not require one.
tty_args=()
[[ -t 1 ]] || tty_args=(-T)

exec scripts/dc exec "${tty_args[@]}" web sh -c \
  'cd /app && exec uv run pytest "$@"' _ "${pytest_args[@]}" "$@"
