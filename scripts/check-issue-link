#!/usr/bin/env python3
"""scripts/check-issue-link — every change names the issue it serves (ONE artifact, MANY invokers).

A change that lands without naming its issue leaves that issue open after the work is done, and
an open issue whose work has landed reads as unfinished work. On 2026-09-03 an audit of ~45 PRs
merged across the org since 2026-08-27 found four carrying a GitHub closing keyword; every other
issue was closed by hand, days later, in a four-repo sweep (tap#327). GitHub links and closes
issues only from a literal `Closes <ref>` in the PR body or title, so the fix is to DERIVE that
line from the commits rather than remember to write it.

The convention (CONTRIBUTING "Commit Messages", `req-cicd-issue-link`): a commit carries one or
more trailers, the same shape as `Signed-off-by:`:

    Closes: unified-systems-com/tap#327          the change completes the issue
    Part-of: unified-systems-com/tap#211         the change advances the issue without completing it
    No-issue: <reason>                           the change deliberately serves no issue (say why)

The reference is the QUALIFIED form `owner/repo#n` (or the issue URL). A bare `#n` is rejected:
it is ambiguous the moment two repositories are in play, and they always are (CLAUDE.md, "name
the repo with every PR and issue number"). Values may list several refs, comma- or space-separated.

The verdict is per RANGE, not per commit: the branch passes when at least one non-merge commit
it adds over the base carries a valid trailer. A fix-up commit need not repeat it. Merge commits
are exempt.

The bot exemption is keyed off the AUTHENTICATED pull-request author's IDENTITY, never off commit
metadata and never off a login string: a git author name/email is contributor-controlled text, so
"authored by renovate" proves nothing (Codex and Grok seats on tap PR #328), and a login is a
mutable, reassignable string, so "tap-renovate[bot]" the name proves little more (tap#342). CI
passes `--pr-author-id <n> --pr-author-type <Bot|User> --pr-author <login>` from
`github.event.pull_request.user.{id,type,login}`. The range is exempt iff the NUMERIC id is one of
the deliberately approved identities in `tap/tap.pr-bots.json` (schema
`tap/schemas/pr-bots.schema.json`) AND the type is `Bot`; the login is printed for diagnostics
only, and a login that disagrees with the approved entry's recorded login is reported. Anything
else — no identity (a local promote, a merge-queue event), a malformed id, an unapproved id, a
matching login with a different id, a matching id with a non-Bot type — falls through to the normal
trailer check. Stock `renovate[bot]` is NOT approved: ours authenticates as `tap-renovate[bot]`.
The allowlist is read as plain JSON by this stdlib-only host tool (shape-checked here, fail-closed
with exit 2 on a malformed file) and validated against its schema by the test suite, the same
split `tap.preboot` uses for boot profiles.

`--emit` prints the normalized lines GitHub parses — `Closes owner/repo#n`, `Part of owner/repo#n`,
`No issue: reason` — for `scripts/promote-pr-body` to place in the PR body, so the link is derived
once, here, and never restated by hand.

ENFORCING from the start (there is no unsigned-history pile to triage): a range with no trailer is
a non-zero exit, which aborts a promote and reds the `dco` CI job. TAP_ISSUE_LINK_REPORT_ONLY=1
lists the verdict and exits 0, for triage. The default lives HERE so an ad-hoc run gives the same
verdict CI will.

Invokers: scripts/promote-to-main.sh (local gates), scripts/promote-pr-body (--emit), and the
`dco` job in .github/workflows/product-lines.yml.

Spec: specs/spec-cicd-hardening.md (req-cicd-issue-link).

Usage:
    scripts/check-issue-link                     # check merge-base(origin/main, HEAD)..HEAD
    scripts/check-issue-link <base-ref>          # explicit base ref
    scripts/check-issue-link --emit [<base-ref>] # print the normalized Closes/Part of/No issue lines
    scripts/check-issue-link --pr-author-id <n> --pr-author-type <type> --pr-author <login> [<base-ref>]
                                                 # CI: exempt the range iff <n> is an approved Bot identity
    TAP_ISSUE_LINK_REPORT_ONLY=1 scripts/check-issue-link   # report without failing
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

#: Trailer keys, matched case-insensitively at the start of a body line.
TRAILER_RE = re.compile(r"^(?P<key>closes|part-of|no-issue):\s*(?P<value>.+?)\s*$", re.IGNORECASE)
#: A qualified issue reference: `owner/repo#n` or `https://github.com/owner/repo/issues/n`.
#: Issue numbers start at 1 — `#0` is a shape with nothing behind it and is not a reference.
REF_RE = re.compile(
    r"(?:(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+)#(?P<num>[1-9]\d*))"
    r"|(?:https?://github\.com/(?P<uowner>[A-Za-z0-9_.-]+)/(?P<urepo>[A-Za-z0-9_.-]+)/issues/(?P<unum>[1-9]\d*))"
)
#: A bare `#n` — rejected on purpose (ambiguous across repositories).
BARE_RE = re.compile(r"(?<![\w/])#\d+\b")
#: The shortest `No-issue:` reason accepted. "fix" is a shrug, not a reason; eight characters is
#: the floor at which a reader can tell what was deliberately skipped.
NO_ISSUE_MIN_REASON_CHARS = 8
#: The declared allowlist of approved pull-request bot IDENTITIES (numeric id + type Bot), read
#: relative to this script so an ad-hoc run and CI consult the same file. Commit author strings and
#: logins are never consulted for authorization.
APPROVED_BOTS_PATH = Path(__file__).resolve().parent.parent / "tap" / "tap.pr-bots.json"
#: The only account type that can be exempt.
BOT_TYPE = "Bot"

#: Record separators for one `git log` call.
_COMMIT_SEP = "\x1e"
_FIELD_SEP = "\x1f"


def _git(*args: str) -> str:
    # nosec B603 B607 — fixed argv: `git` resolved from PATH, arguments are this script's own literals.
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout  # nosec B603 B607


def _base_ref(explicit: str | None) -> str:
    if explicit:
        return explicit
    return _git("merge-base", "origin/main", "HEAD").strip()


def _commits(base: str) -> list[tuple[str, str, str]]:
    """(sha, author, body) for every non-merge commit in base..HEAD, oldest first."""
    raw = _git(
        "log", "--no-merges", "--reverse", f"--format=%H{_FIELD_SEP}%an <%ae>{_FIELD_SEP}%B{_COMMIT_SEP}", f"{base}..HEAD"
    )
    out: list[tuple[str, str, str]] = []
    for record in raw.split(_COMMIT_SEP):
        if not record.strip():
            continue
        sha, author, body = record.lstrip("\n").split(_FIELD_SEP, 2)
        out.append((sha, author, body))
    return out


class AllowlistError(Exception):
    """The approved-bots file is missing or malformed: a configuration error, never a silent pass."""


def load_approved_bots(path: Path = APPROVED_BOTS_PATH) -> dict[int, str]:
    """Return {numeric id: recorded login} from the allowlist, shape-checked (stdlib, fail-closed).

    The schema (`tap/schemas/pr-bots.schema.json`) is the full contract and is enforced by test;
    this reader asserts the load-bearing shape — an object with an `approved` list of objects
    carrying a positive integer `id`, `type == "Bot"` and a string `login` — so a malformed file
    can never widen the exemption.
    """
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise AllowlistError(f"cannot read approved-bots allowlist {path}: {exc}") from exc
    entries = data.get("approved") if isinstance(data, dict) else None
    if not isinstance(entries, list):
        raise AllowlistError(f"{path}: expected an object with an `approved` list")
    approved: dict[int, str] = {}
    for i, entry in enumerate(entries):
        if not isinstance(entry, dict):
            raise AllowlistError(f"{path}: approved[{i}] is not an object")
        ident, kind, login = entry.get("id"), entry.get("type"), entry.get("login")
        if not isinstance(ident, int) or isinstance(ident, bool) or ident < 1:
            raise AllowlistError(f"{path}: approved[{i}].id must be a positive integer, got {ident!r}")
        if kind != BOT_TYPE:
            raise AllowlistError(f"{path}: approved[{i}].type must be {BOT_TYPE!r}, got {kind!r}")
        if not isinstance(login, str) or not login:
            raise AllowlistError(f"{path}: approved[{i}].login must be a non-empty string")
        if ident in approved:
            raise AllowlistError(f"{path}: approved id {ident} is listed twice")
        approved[ident] = login
    return approved


def exempt_author(author_id: str, author_type: str, login: str, approved: dict[int, str]) -> tuple[bool, str]:
    """Decide the exemption from the AUTHENTICATED identity; return (exempt, one-line reason).

    Authorization is `id in approved and type == "Bot"`. The login only shapes the message —
    a matching login with the wrong id, or a matching id with the wrong type, is not exempt.
    """
    who = login or "<no login>"
    if not author_id:
        return False, f"pull request by {who}: no authenticated author id passed — not a bot exemption"
    try:
        ident = int(author_id)
    except ValueError:
        return False, f"pull request by {who}: author id {author_id!r} is not an integer — not a bot exemption"
    if ident not in approved:
        return False, f"pull request by {who} (id {ident}, type {author_type or '?'}) is not an approved bot identity"
    if author_type != BOT_TYPE:
        return False, f"pull request by {who}: id {ident} is approved but type is {author_type!r}, not {BOT_TYPE!r}"
    recorded = approved[ident]
    note = "" if login == recorded else f" (login now {who!r}; approved as {recorded!r})"
    return True, f"pull request authored by approved bot {recorded} (id {ident}){note}; a maintainer certifies it at merge."


def parse_trailers(body: str) -> tuple[list[tuple[str, str]], list[str]]:
    """Return ([(kind, normalized value)], [problems]) for one commit body.

    `kind` is `closes`, `part-of` or `no-issue`; the value is `owner/repo#n` for the first two and
    the reason text for the third. A trailer whose value carries a bare `#n` or no qualified ref
    at all is a problem, not a silent skip — a malformed link reads as a link.
    """
    found: list[tuple[str, str]] = []
    problems: list[str] = []
    for line in body.splitlines():
        m = TRAILER_RE.match(line.strip())
        if not m:
            continue
        key = m.group("key").lower()
        value = m.group("value")
        if key == "no-issue":
            if len(value.strip()) < NO_ISSUE_MIN_REASON_CHARS:
                problems.append(f"`No-issue:` needs a reason, not {value!r}")
            else:
                found.append((key, value.strip()))
            continue
        refs = [
            f"{r.group('owner') or r.group('uowner')}/{r.group('repo') or r.group('urepo')}#{r.group('num') or r.group('unum')}"
            for r in REF_RE.finditer(value)
        ]
        bare = BARE_RE.findall(REF_RE.sub("", value))
        if bare:
            problems.append(
                f"`{m.group('key')}:` carries a bare {', '.join(bare)} — write the qualified `owner/repo#n` form"
            )
        if not refs and not bare:
            problems.append(f"`{m.group('key')}:` names no issue reference: {value!r}")
        found.extend((key, ref) for ref in refs)
    return found, problems


def _emit_lines(trailers: list[tuple[str, str]]) -> list[str]:
    """The lines GitHub parses, deduplicated, closes first."""
    order = {"closes": 0, "part-of": 1, "no-issue": 2}
    labels = {"closes": "Closes {}", "part-of": "Part of {}", "no-issue": "No issue: {}"}
    seen: set[tuple[str, str]] = set()
    lines: list[str] = []
    def _key(t: tuple[str, str]) -> tuple[int, str, int]:
        # Numeric on the issue number, so `repo#2` precedes `repo#10` in the PR body.
        kind, value = t
        repo, _, num = value.rpartition("#")
        return (order[kind], repo, int(num) if num.isdigit() else 0)

    for kind, value in sorted(trailers, key=_key):
        if (kind, value) in seen:
            continue
        seen.add((kind, value))
        lines.append(labels[kind].format(value))
    return lines


def main(argv: list[str]) -> int:
    emit = "--emit" in argv
    args = [a for a in argv if a != "--emit"]
    identity = {"--pr-author": "", "--pr-author-id": "", "--pr-author-type": ""}
    for flag in list(identity):
        if flag in args:
            i = args.index(flag)
            if i + 1 >= len(args):
                print(f"check-issue-link: {flag} needs a value", file=sys.stderr)
                return 2
            identity[flag] = args[i + 1].strip()
            del args[i : i + 2]
    if len(args) > 1:
        print(__doc__.split("Usage:")[1].rstrip(), file=sys.stderr)
        return 2
    base = _base_ref(args[0] if args else None)
    pr_author = identity["--pr-author"]

    exemption_note = ""
    if any(identity.values()):
        try:
            approved = load_approved_bots()
        except AllowlistError as exc:
            print(f"check-issue-link: {exc}", file=sys.stderr)
            return 2
        exempt, reason = exempt_author(identity["--pr-author-id"], identity["--pr-author-type"], pr_author, approved)
        if exempt:
            # The only exemption, and it rests on GitHub's authenticated identity, not on git metadata.
            if not emit:
                print(f"check-issue-link: OK — {reason}")
            return 0
        exemption_note = f" ({reason})"

    trailers: list[tuple[str, str]] = []
    problems: list[str] = []
    considered = 0
    for sha, _author, body in _commits(base):
        considered += 1
        found, bad = parse_trailers(body)
        trailers.extend(found)
        problems.extend(f"{sha[:12]}: {p}" for p in bad)

    if emit:
        for line in _emit_lines(trailers):
            print(line)
        # A malformed trailer must not become a half-right PR body: fail here too.
        for p in problems:
            print(f"check-issue-link: {p}", file=sys.stderr)
        return 1 if problems else 0

    report_only = os.environ.get("TAP_ISSUE_LINK_REPORT_ONLY") == "1"
    ok = bool(trailers) and not problems
    if considered == 0:
        print(f"check-issue-link: no non-merge commits over {base[:12]} — nothing to check.")
        return 0
    if ok:
        print(f"check-issue-link: OK — {considered} commit(s) over {base[:12]}; " + "; ".join(_emit_lines(trailers)))
        return 0
    if not trailers:
        print(
            f"check-issue-link: FAIL — none of the {considered} commit(s) over {base[:12]} names its issue{exemption_note}.\n"
            "  Add a trailer to a commit (git commit --amend, or a follow-up commit):\n"
            "    Closes: owner/repo#n      the change completes the issue\n"
            "    Part-of: owner/repo#n     the change advances it without completing it\n"
            "    No-issue: <reason>        deliberately serves no issue — say why\n"
            "  The qualified owner/repo#n form is required; a bare #n is ambiguous across repositories."
        )
    for p in problems:
        print(f"  {p}")
    if report_only:
        print("check-issue-link: TAP_ISSUE_LINK_REPORT_ONLY=1 — reporting only, not failing.")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
