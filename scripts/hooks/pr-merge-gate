#!/usr/bin/env bash
# Claude Code PreToolUse hook — refuse to merge a PR whose AI review nobody answered.
#
# Wired by .claude/settings.json, which holds ONLY a pointer to this file, for the
# same reason as its sibling pr-triage-nudge: a hook body inlined into settings.json
# is a JSON-escaped one-liner that cannot be read in review, linted, or tested.
#
# THE DIFFERENCE FROM THE NUDGE, and the whole point of this file: the nudge is a
# PostToolUse REMINDER whose own contract is "it cannot fail the tool call". A
# reminder is a promise, and promises are what failed. On 2026-09-11 a subagent
# reported "no seat findings" for PR# 384 - tap while the Grok seat had posted three
# findings, one of them `Verdict: merge-blocker`; the parent relayed the summary and
# nothing in the machinery could object. A later sweep found PR# 386 carrying an
# unanswered `## high`, and PR# 371 MERGED with a `SEAT ABSENT` never answered.
# This hook runs BEFORE the tool call and is allowed to DENY it (tap#390).
#
# It holds itself to the nudge's safety rules, minus the one that made the nudge
# unable to help:
#   1. It reads. It never executes the matched command, writes a file, opens a
#      socket, or touches a credential store.
#   2. It MAY deny the tool call — that is its purpose — but it denies only the
#      merge commands it recognises, and it is a no-op for every other Bash call.
#   3. Its logic lives here, where it can be read, linted and tested.
#
# FAIL CLOSED. If the verdict cannot be established — no `gh`, no `jq`, the repo
# cannot be resolved, the review has not arrived, a seat was ABSENT — this denies
# and says which. The alternative is the failure it exists to prevent: an
# unanswerable question read as a clean answer. This is the same direction taken
# for the boot-tier classifier after a silent degrade let a required lane skip
# (tap#379).
#
# ONE OVERRIDE, and it must be typed: TAP_PR_MERGE_GATE=off in the environment of
# that call. It is named in every denial. A documented override that a human types
# is a decision; a silent fallback is not.
#
# Input: the PreToolUse hook payload as JSON on stdin.
# Output: nothing (allow — normal permission flow applies), or a hookSpecificOutput
#   object with permissionDecision "deny". Contract:
#   https://code.claude.com/docs/en/hooks — {hookSpecificOutput: {hookEventName:
#   "PreToolUse", permissionDecision: "deny", permissionDecisionReason: "..."}}.
#   Exit 0 either way; exit 2 is the other blocking route (stderr as the message)
#   and is deliberately NOT used, so the reason arrives as structured text.
#
# Spec: specs/spec-dev-local-execution.md
# Skill: .claude/skills/close-out-pr/SKILL.md — the procedure this gate enforces.

set -euo pipefail

deny() {
  # $1 = reason. Structured deny; exit 0 so the JSON is what decides.
  if command -v jq >/dev/null 2>&1; then
    jq -nc --arg r "$1" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
  else
    # No jq: fall back to the exit-2 route so a missing tool still blocks rather
    # than silently allowing. (Reaching here means jq vanished mid-run; the
    # matcher below needs jq to have parsed the payload at all.)
    echo "$1" >&2
    exit 2
  fi
  exit 0
}

# Without jq the payload cannot be parsed, so the command is unknown. Unknown is
# not "not a merge" — but this hook fires on EVERY Bash call, and denying every
# call on a machine without jq would wedge the contributor entirely. The narrow,
# stated compromise: no jq, no gate. The repo's own tooling requires jq anyway
# (scripts/pr-review-triage exits 2 without it), so this is a machine that cannot
# run the merge road regardless.
command -v jq >/dev/null 2>&1 || exit 0

command_text="$(jq -r '.tool_input.command // empty' 2>/dev/null || true)"
[ -n "$command_text" ] || exit 0

# Match a MERGE as a command in its own right — at the start or after a separator —
# so that merely mentioning the string (in an echo, a comment, or a grep pattern)
# does not fire the gate. Three spellings reach a merge:
#   gh pr merge <n>
#   gh api ... /pulls/<n>/merge
#   gh api ... /pulls/<n>/merge-async   (GitHub refuses `gh pr merge` on stacked PRs)
# A `gh` invocation may be spelled with a path (`/usr/bin/gh`), or prefixed by
# `command`/`env`/`sudo`/`\`; those are the cheap bypasses of a naive matcher, so
# they are folded in here. What is NOT covered, deliberately and stated so nobody
# mistakes this for a sandbox: a raw `curl` to the merge API, a shell function or
# alias, or a merge performed by some other client. This is a seatbelt against the
# 2026-09-11 incident — a summary relayed as fact — not a containment boundary. An
# agent determined to route around it can; an agent that simply forgot cannot.
sep='(^|[;&|(]|&&|\|\|)[[:space:]]*(command[[:space:]]+|env[[:space:]]+|sudo[[:space:]]+|\\)*([^[:space:]]*/)?'
is_merge=0
printf '%s' "$command_text" | grep -qE "${sep}gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$)" && is_merge=1
printf '%s' "$command_text" | grep -qE "${sep}gh[[:space:]]+api\b.*/pulls/[0-9]+/merge(-async)?\b" && is_merge=1
[ "$is_merge" -eq 1 ] || exit 0

# The override is read here, AFTER the command is known to be a merge, so that a
# session with it set does not silently disable anything else.
if [ "${TAP_PR_MERGE_GATE:-}" = "off" ]; then
  exit 0
fi

# The PR number: `gh pr merge <n>` or `/pulls/<n>/merge`. A merge with no explicit
# number (gh infers it from the current branch) is NOT parseable here, and an
# unparseable merge is denied rather than waved through.
pr="$(printf '%s' "$command_text" | grep -oE '/pulls/[0-9]+/merge' | grep -oE '[0-9]+' | head -1 || true)"
if [ -z "$pr" ]; then
  pr="$(printf '%s' "$command_text" \
        | grep -oE "gh[[:space:]]+pr[[:space:]]+merge[[:space:]]+[0-9]+" \
        | grep -oE '[0-9]+$' | head -1 || true)"
fi
if [ -z "$pr" ]; then
  deny "PR merge gate (tap#390): this merge names no PR number, so the AI-review verdict for it cannot be checked. Re-run as \`gh pr merge <number> --repo <owner>/<repo>\`, or set TAP_PR_MERGE_GATE=off for this call if you have read the review yourself."
fi

# The repo: an explicit --repo/-R wins; otherwise gh resolves it from the cwd.
repo="$(printf '%s' "$command_text" | grep -oE '(--repo|-R)[[:space:]]+[A-Za-z0-9._-]+/[A-Za-z0-9._-]+' | awk '{print $2}' | head -1 || true)"
if [ -z "$repo" ]; then
  repo="$(printf '%s' "$command_text" | grep -oE 'repos/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/pulls/' | sed 's|^repos/||; s|/pulls/$||' | head -1 || true)"
fi

command -v gh >/dev/null 2>&1 || deny "PR merge gate (tap#390): \`gh\` is not on PATH, so PR #${pr}'s AI review cannot be read. The verdict is UNKNOWN, which is not clean — that reading is the failure this gate exists to prevent. Install gh, or set TAP_PR_MERGE_GATE=off for this call if you have read the review yourself."

# The gate itself lives in scripts/pr-review-triage --assert-answered: one
# definition of "unanswered", shared by the hook and by anyone running it by hand.
root="$(cd "$(dirname "$0")/../.." && pwd)"
triage="$root/scripts/pr-review-triage"
[ -x "$triage" ] || deny "PR merge gate (tap#390): cannot find scripts/pr-review-triage at ${triage}, so PR #${pr}'s review cannot be checked. Set TAP_PR_MERGE_GATE=off for this call if you have read the review yourself."

set +e
if [ -n "$repo" ]; then
  findings="$(GH_REPO="$repo" "$triage" "$pr" --assert-answered 2>&1)"
else
  findings="$(cd "$root" && "$triage" "$pr" --assert-answered 2>&1)"
fi
rc=$?
set -e

if [ "$rc" -ne 0 ]; then
  deny "PR merge gate (tap#390) — PR #${pr}${repo:+ in $repo} has AI-review findings nobody answered, so this merge is refused:

${findings}

Answer each one on the PR with the settling evidence it asked for (a conscious dismissal counts and is required in writing), then merge. A SEAT ABSENT line is a MISSING verdict, never a clean one. Procedure: .claude/skills/close-out-pr/SKILL.md. Override for this call only, if you have read the review yourself: TAP_PR_MERGE_GATE=off."
fi

exit 0
