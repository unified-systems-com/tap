diff -ruN code-today/tap_grid/identity_claim.py code-claim/tap_grid/identity_claim.py
--- code-today/tap_grid/identity_claim.py	1969-12-31 16:00:00.000000000 -0800
+++ code-claim/tap_grid/identity_claim.py	2026-11-23 16:30:23.506860677 -0800
@@ -0,0 +1,77 @@
+"""PROTOTYPE (Issue 1348, scratch copy only): identity claims as row locks instead of advisory locks.
+
+One row per identity fingerprint in ``tap_identity_claim``. Claiming a set of identities is one
+statement in fingerprint order: a new fingerprint inserts its row (and holds it until commit as an
+uncommitted insert), an existing one is row-locked by ``DO UPDATE``. Row locks are kept in the tuple,
+not in the shared lock table, so a batch's lock-table use does not grow with its size.
+
+Mode (env TAP_CLAIM_MODE): ``update`` (default) or ``nothing`` (DO NOTHING, then SELECT ... FOR UPDATE
+in the same order).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+from collections.abc import Iterable
+
+from django.db import connection
+
+TABLE = "tap_identity_claim"
+RECIPE = 1
+_DDL = (
+    f"CREATE TABLE IF NOT EXISTS {TABLE} ("
+    " fingerprint bytea PRIMARY KEY,"
+    " entity_type varchar(255) NOT NULL,"
+    " recipe smallint NOT NULL,"
+    " claimed_at timestamptz NOT NULL DEFAULT now())"
+)
+_ready = False
+
+
+def fingerprint(key: str) -> bytes:
+    return hashlib.sha256(f"{RECIPE}\x1e{key}".encode()).digest()
+
+
+def _type_of(key: str) -> str:
+    return key.split("\x1f", 1)[0][:255]
+
+
+def claim(keys: Iterable[str]) -> None:
+    global _ready
+    rows = sorted({fingerprint(k): _type_of(k) for k in keys}.items())
+    if not rows:
+        return
+    with connection.cursor() as cursor:
+        if True:  # checked every call: a test transaction that created it may have rolled back
+            # Prototype only: the test database is built from the models, so the migration's RunSQL does
+            # not run there. Serialise the one-time creation on a single constant advisory lock.
+            cursor.execute("SELECT to_regclass(%s)", [TABLE])
+            if cursor.fetchone()[0] is None:
+                cursor.execute("SELECT pg_advisory_xact_lock(1348)")
+                cursor.execute(_DDL)
+            _ready = True
+        fps = [f for f, _ in rows]
+        types = [t for _, t in rows]
+        if os.environ.get("TAP_CLAIM_MODE", "update") == "nothing":
+            cursor.execute(
+                f"INSERT INTO {TABLE} (fingerprint, entity_type, recipe) "
+                "SELECT f, t, %s FROM unnest(%s::bytea[], %s::text[]) AS u(f, t) ORDER BY f "
+                "ON CONFLICT (fingerprint) DO NOTHING",
+                [RECIPE, fps, types],
+            )
+            cursor.execute(
+                f"SELECT count(*) FROM (SELECT 1 FROM {TABLE} WHERE fingerprint = ANY(%s::bytea[]) "
+                "ORDER BY fingerprint FOR UPDATE) l",
+                [fps],
+            )
+            got = cursor.fetchone()[0]
+            if got != len(fps):  # a claim pruned between the two statements: claim again
+                claim(keys)
+        else:
+            cursor.execute(
+                f"INSERT INTO {TABLE} (fingerprint, entity_type, recipe) "
+                "SELECT f, t, %s FROM unnest(%s::bytea[], %s::text[]) AS u(f, t) ORDER BY f "
+                "ON CONFLICT (fingerprint) DO UPDATE SET claimed_at = now()",
+                [RECIPE, fps, types],
+            )
