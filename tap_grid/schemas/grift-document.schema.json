{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tap:grift:v0:document",
  "title": "GRIFT Document v0",
  "description": "TAP Grid Interchange Format document. See tap_grid/specs/spec-grift-v0.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "_reserved", "batches"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grift_version"],
      "properties": {
        "grift_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "_reserved": {
      "type": "object"
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GriftBatchContainer"
      }
    }
  },
  "$defs": {
    "GriftEntityEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "dimensions"],
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Batch-local name for a node or edge the sender has not yet learned an id for; exactly one of entity_id and ref is present (the oneOf below). The importer resolves every ref to an id before preflight and reports the ref -> id map per imported batch; a ref never reaches a record. Unique within its batch; an edge endpoint names a node of the same batch by from_ref / to_ref. Not permitted on batch_entity or on a removal target. The gate, shape A: Issue# 571 - tap."
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "entity_expected_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional optimistic-concurrency declaration: the local Entity.version the sender expects to act on. Enforced atomically by the importer at execution time. See req-grift-concurrency-version."
        }
      },
      "oneOf": [
        {
          "required": ["entity_id"]
        },
        {
          "required": ["ref"]
        }
      ]
    },
    "GriftNodeObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "node"],
      "properties": {
        "entity": {
          "$ref": "#/$defs/GriftEntityEnvelope"
        },
        "node": {
          "type": "object"
        },
        "retirement": {
          "$ref": "#/$defs/GriftRetirement"
        }
      }
    },
    "GriftEdgePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_type", "properties"],
      "properties": {
        "from_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "from_ref": {
          "type": "string",
          "minLength": 1,
          "description": "The edge's source named by a node ref of the same batch; exactly one of from_entity_id and from_ref is present."
        },
        "to_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "to_ref": {
          "type": "string",
          "minLength": 1,
          "description": "The edge's target named by a node ref of the same batch; exactly one of to_entity_id and to_ref is present."
        },
        "edge_type": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["from_entity_id"]
            },
            {
              "required": ["from_ref"]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["to_entity_id"]
            },
            {
              "required": ["to_ref"]
            }
          ]
        }
      ]
    },
    "GriftEdgeObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "edge"],
      "properties": {
        "entity": {
          "$ref": "#/$defs/GriftEntityEnvelope"
        },
        "edge": {
          "$ref": "#/$defs/GriftEdgePayload"
        },
        "retirement": {
          "$ref": "#/$defs/GriftRetirement"
        }
      }
    },
    "GriftBatchContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_entity", "batch_node", "nodes", "edges"],
      "properties": {
        "batch_entity": {
          "$ref": "#/$defs/GriftEntityEnvelope"
        },
        "batch_node": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GriftNodeObject"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GriftEdgeObject"
          }
        },
        "deletes": {
          "$ref": "#/$defs/GriftDeletesSection"
        },
        "purges": {
          "$ref": "#/$defs/GriftPurgesSection"
        },
        "contents": {
          "$ref": "#/$defs/GriftContents"
        }
      }
    },
    "GriftRetirement": {
      "description": "The entity's retirement in the grid the record came from, carried as plain data. Present only on a retired node or edge. It is the source grid's record, never the importing grid's provenance: the importer retires the row in its own batch and keeps this block beside that record. See req-grift-retirement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["retired_at", "batch_id", "reason", "metadata"],
      "properties": {
        "retired_at": {
          "description": "When the source grid retired the entity (its Entity.deleted_at).",
          "type": "string",
          "format": "date-time"
        },
        "batch_id": {
          "description": "The source grid's retiring batch, or null when the source grid recorded none.",
          "oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]
        },
        "reason": {
          "description": "The reason the source grid recorded for the retirement, or null when it recorded no retirement event for this entity.",
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "metadata": {
          "description": "The rest of the source grid's retirement event metadata; empty when it recorded none.",
          "type": "object"
        }
      }
    },
    "GriftContents": {
      "description": "What kinds of record this batch carries, one key per aspect. The exporter declares; the importer verifies the declaration against the batch and decides which aspects it accepts. An aspect declared included:false is always accepted. See req-grift-contents.",
      "type": "object",
      "required": ["tombstones"],
      "properties": {
        "tombstones": {
          "description": "Retired nodes and edges, each carrying a retirement block; nodes and edges are their counts in this batch.",
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "nodes", "edges"],
          "properties": {
            "included": {"type": "boolean"},
            "nodes": {"type": "integer", "minimum": 0},
            "edges": {"type": "integer", "minimum": 0}
          }
        }
      },
      "additionalProperties": {
        "description": "An aspect this version does not define (for example history or flip). Its included flag says whether the batch carries it.",
        "type": "object",
        "required": ["included"],
        "properties": {
          "included": {"type": "boolean"}
        }
      }
    },
    "GriftRemovalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "reason"],
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "entity_expected_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional optimistic-concurrency declaration: the local Entity.version the sender expects to remove. Enforced atomically by the importer at execution time. See req-grift-concurrency-version."
        }
      }
    },
    "GriftDeletesSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_missing", "on_tombstoned", "edges", "nodes"],
      "properties": {
        "on_missing": {
          "enum": ["error", "warn", "ignore"]
        },
        "on_tombstoned": {
          "enum": ["error", "warn", "ignore"]
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GriftRemovalTarget"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GriftRemovalTarget"
          }
        }
      }
    },
    "GriftPurgesSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_missing", "edges", "nodes"],
      "properties": {
        "on_missing": {
          "enum": ["error", "warn", "ignore"]
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GriftRemovalTarget"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GriftRemovalTarget"
          }
        }
      }
    }
  }
}
