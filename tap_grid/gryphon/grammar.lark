// TAP Traversal Language Grammar
// Authoritative syntax specification for spec-grid-traversal-execution.md
// Parser: lark earley, ambiguity=resolve
//
// Convention: terminals prefixed with _ are discarded from parse-tree children.
// This keeps transformer methods clean — they receive only data tokens, not keywords.

start: clause+

clause: match_clause
      | optional_match_clause
      | where_clause
      | return_clause
      | not_exists_clause
      | order_by_clause
      | limit_clause

// ---------------------------------------------------------------------------
// NOT EXISTS subquery (correlated anti-join)
// ---------------------------------------------------------------------------

not_exists_clause: _NOT_KW _EXISTS_KW "{" match_clause where_clause? "}"

// ---------------------------------------------------------------------------
// MATCH
// ---------------------------------------------------------------------------

match_clause: _MATCH_KW path_var? pattern ("," pattern)*

// OPTIONAL MATCH — left-outer-join semantics: the pattern binds where it can,
// and where it cannot the mandatory rows are still kept (the optional
// variables go unbound rather than dropping the row).
optional_match_clause: _OPTIONAL_KW _MATCH_KW pattern ("," pattern)*

path_var: NAME "="

pattern: node_pattern (edge_pattern node_pattern)*

node_pattern: "(" node_body ")"
node_body: node_body_var? node_body_label? inline_props?
node_body_var:   NAME
node_body_label: ":" NAME

edge_pattern: outbound_edge
            | inbound_edge
            | undirected_edge

outbound_edge:   "-[" edge_body "]->"
inbound_edge:    "<-[" edge_body "]-"
undirected_edge: "-[" edge_body "]-"

edge_body: edge_body_var? edge_body_type? hop_range? inline_props?
edge_body_var:  NAME
edge_body_type: ":" NAME
hop_range: "*" INT ".." INT

inline_props: "{" prop_pair ("," prop_pair)* "}"
prop_pair: NAME ":" value

// ---------------------------------------------------------------------------
// WHERE
// ---------------------------------------------------------------------------

where_clause: _WHERE_KW predicate

// Precedence (lowest to highest): OR < AND < NOT < atom.
// Earley with ambiguity=resolve handles left-recursive OR/AND.
predicate: predicate _OR_KW predicate    -> or_pred
         | predicate _AND_KW predicate   -> and_pred
         | _NOT_KW predicate             -> not_pred
         | "(" predicate ")"             -> paren_pred
         | comparison
         | param_test

// A predicate about a runtime INPUT rather than about graph data
// (req-grid-traversal-lang-param-null). The optional-filter idiom:
//   WHERE $org IS NULL OR o.data.name = $org
// -- "if this input was not supplied, do not constrain on it." Resolved
// against the supplied inputs BEFORE lowering, so the not-supplied case emits
// the unfiltered plan rather than a no-op predicate.
param_test: param_ref _IS_KW _NULL_KW           -> param_is_null
          | param_ref _IS_KW _NOT_KW _NULL_KW   -> param_is_not_null

comparison: field_path COMPARE_OP value
          | field_path STRING_OP value
          | field_path "=~" value                  -> regex_comparison
          | field_path _IN_KW value_list           -> in_comparison
          | field_path _IS_KW _NULL_KW             -> is_null
          | field_path _IS_KW _NOT_KW _NULL_KW     -> is_not_null
          | field_path _IS_KW _KNOWN_KW            -> is_known
          | field_path _IS_KW _UNKNOWN_KW          -> is_unknown

// Membership test: the field value must equal one of the listed values.
// List elements may be literals or $param references; an empty list matches
// nothing. NULL has no defined equality, so a NULL element matches nothing.
value_list: "[" (value ("," value)*)? "]"

field_path: NAME field_step*
field_step: "." NAME               -> dot_step
          | "[" ESCAPED_STRING "]" -> key_step
          | "[" INT "]"            -> index_step
          | "[" STAR "]"           -> wildcard_step

STAR: "*"
COMPARE_OP: "=" | "!=" | "<=" | ">=" | "<" | ">"
// Substring operators — kept (not underscore-discarded): the transformer
// reads which operator matched, exactly as for COMPARE_OP.
STRING_OP: /STARTS_WITH|ENDS_WITH|CONTAINS/i

// ---------------------------------------------------------------------------
// RETURN
// ---------------------------------------------------------------------------

return_clause: _RETURN_KW return_item ("," return_item)*

return_item: aggregate_call _AS_KW NAME   -> aggregate_item
           | field_path (_AS_KW NAME)?    -> field_item

aggregate_call: _COUNT_KW "(" field_path ")"

// ---------------------------------------------------------------------------
// ORDER BY / LIMIT
// ---------------------------------------------------------------------------
//
// Row-projection mode: an order_item names a RETURN output by its alias (or,
// for an unaliased field projection, its last dot-step name) — a bare NAME is
// the original surface and still parses as a degenerate field_path.
// Envelope mode (req-grid-gryphon-order-by-envelope): an order_item carries a
// full field_path (e.g. ORDER BY n.data.fetched_at DESC) that the executor
// resolves through the same machinery as a WHERE field path.

order_by_clause: _ORDER_KW _BY_KW order_item ("," order_item)*
order_item: field_path order_dir?
order_dir: _ASC_KW  -> asc
         | _DESC_KW -> desc

limit_clause: _LIMIT_KW INT

// ---------------------------------------------------------------------------
// Values
// ---------------------------------------------------------------------------

value: ESCAPED_STRING  -> string_val
     | NUMBER          -> number_val
     | param_ref
     | /true/i         -> true_val
     | /false/i        -> false_val
     | _NULL_KW        -> null_val

param_ref: "$" NAME

// ---------------------------------------------------------------------------
// Keywords — underscore prefix causes lark to discard them from tree children
// ---------------------------------------------------------------------------

_MATCH_KW:  /MATCH/i
_OPTIONAL_KW: /OPTIONAL/i
_WHERE_KW:  /WHERE/i
_RETURN_KW: /RETURN/i
_AND_KW:    /AND/i
_OR_KW:     /OR/i
_NOT_KW:    /NOT/i
_AS_KW:     /AS/i
_IN_KW:     /IN/i
_EXISTS_KW: /EXISTS/i
_COUNT_KW:  /COUNT/i
_IS_KW:     /IS/i
_NULL_KW:   /NULL/i
// Observation-semantic predicates (req-grid-traversal-lang-observation): the
// convention's null axis surfaced as intent-revealing keywords. KNOWN/UNKNOWN
// become reserved words (like NULL); a field literally named known/unknown must
// be reached via bracket key-step notation.
_KNOWN_KW:   /KNOWN/i
_UNKNOWN_KW: /UNKNOWN/i
_ORDER_KW:  /ORDER/i
_BY_KW:     /BY/i
_ASC_KW:    /ASC/i
_DESC_KW:   /DESC/i
_LIMIT_KW:  /LIMIT/i

// ---------------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------------

NAME:   /[a-zA-Z_][a-zA-Z0-9_]*/
INT:    /[0-9]+/
NUMBER: /-?[0-9]+(\.[0-9]+)?/

%import common.ESCAPED_STRING
%import common.WS
%ignore WS
