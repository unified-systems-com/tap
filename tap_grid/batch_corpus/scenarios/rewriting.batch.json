{
  "family": "rewriting",
  "description": "Reference rewriting (FHIR: temporary urn:uuid ids rewritten wherever they appear; JSON:API atomic operations: lid scoped to the request): every binding a batch reports is the id actually written on each edge endpoint — self-loops, cycles, diamonds, mixed existing/assigned endpoints — and payload text that merely resembles a ref is never touched.",
  "scenarios": [
    {
      "name": "a self-loop on a ref lands on the assigned id at both ends",
      "tags": [],
      "covers": [
        "req-grid-import-grift-identity-3",
        "req-grift-edge"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "p",
                  "type": "panel",
                  "props": {
                    "name": "Home",
                    "slug": "home",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ],
              "edges": [
                {
                  "ref": "e",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "p",
                  "to": "p"
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "p": 1,
          "e": 1
        },
        "tombstoned": {},
        "absent": [],
        "note": "The runner checks the edge's from and to against the id the batch reported for p: one row, one loop."
      }
    },
