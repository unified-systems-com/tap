{
  "family": "atomic",
  "description": "Atomicity by failure position (JSON:API atomic operations: a failure invalidates the effects of preceding operations): first, middle and last op; the reported counts are what committed, never the successful prefix (Issue# 607 - tap); schema/preflight refusal versus execution failure across two batches.",
  "scenarios": [
    {
      "name": "a failure at the first op writes nothing",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grift-concurrency-version-7",
        "req-grid-import-grift-occ-3"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  },
                  "expected_version": 1
                },
                {
                  "id": "Y",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Y"
                  },
                  "expected_version": null
                },
                {
                  "id": "Z",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Z"
                  },
                  "expected_version": null
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "failed"
            },
            "errors": [
              {
                "code": "entity_version_conflict",
                "path": "$.batches[0].nodes[0].entity.entity_expected_version"
              }
            ],
            "counts": {
              "b1": {
                "nodes": 0,
                "edges": 0
              }
            }
          }
        ],
        "live": {},
        "tombstoned": {},
        "absent": [
          "X",
          "Y",
          "Z"
        ],
        "note": "The version expectation on a missing row conflicts at position 0; nothing after it runs, nothing is written, the count is zero."
      }
    },
    {
      "name": "a failure at the middle op rolls back the successful prefix and reports zero imported (Issue# 607 - tap)",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-import-grift-occ-2",
        "req-grid-import-grift-results-1"
      ],
      "pending": "unified-systems-com/tap#607",
      "grid": {
        "nodes": [
          {
            "name": "Y",
            "type": "grid_fixtures__node",
            "props": {
              "name": "Y"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  }
                },
                {
                  "id": "Y",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Y, again"
                  },
                  "expected_version": 9
                },
                {
                  "id": "Z",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Z"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "failed"
            },
            "errors": [
              {
                "code": "entity_version_conflict",
                "path": "$.batches[0].nodes[1]"
              }
            ],
            "counts": {
              "b1": {
                "nodes": 0,
                "edges": 0
              }
            }
          }
        ],
        "live": {
          "Y": 1
        },
        "tombstoned": {},
        "absent": [
          "X",
          "Z"
        ],
        "note": "X was created before Y's stale expectation was refused by the verb; the batch rolled back, so X has no row — and the reported nodes_imported must say 0, what committed, not 1, what was attempted. Today the successful prefix is counted (Issue# 607 - tap). A missing-row expectation would not show it: that conflict is found before any op runs."
      }
    },
