          {
            "name": "Z",
            "type": "grid_fixtures__node",
            "props": {
              "name": "Z"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A"
                  }
                }
              ]
            },
            {
              "name": "b2",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  }
                },
                {
                  "id": "Y",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Y"
                  }
                },
                {
                  "id": "Z",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Z, again"
                  },
                  "expected_version": 9
