            "errors": [
              {
                "code": "entity_version_conflict",
                "path": "$.batches[0].nodes[0]"
              }
            ]
          }
        ],
        "live": {
          "A": 1,
          "B": 1
        },
        "tombstoned": {},
        "absent": [],
        "note": "The first document fails preflight: neither batch runs and A is untouched even though b1 alone would have succeeded. The second fails in execution: b3 rolls back, b4 lands, A still untouched."
      }
