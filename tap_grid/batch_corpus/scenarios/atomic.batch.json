    {
      "name": "a preflight refusal versus an execution failure: the first leaves no batch row for any batch, the second only for its own",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-import-grift-preflight-2",
        "req-grid-import-grift-results-1"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A"
                  },
                  "expected_version": 1
                }
              ]
            },
            {
              "name": "b2",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A twice"
                  }
                }
              ]
            }
          ]
        },
        {
          "batches": [
            {
              "name": "b3",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, by b3"
                  },
                  "expected_version": 9
                }
              ]
            },
            {
              "name": "b4",
              "nodes": [
                {
                  "id": "B",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "B"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "refused",
              "b2": "refused"
