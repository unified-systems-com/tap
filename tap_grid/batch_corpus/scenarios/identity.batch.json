                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  }
                }
              ]
            }
          ]
        },
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
