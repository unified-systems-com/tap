{
  "family": "identity",
  "description": "Identity by id: an id that exists routes to replace, else to create; the batch id is the import identity and a seen batch is skipped whatever its content; a tombstone is terminal; the id path never searches.",
  "scenarios": [
    {
      "name": "a new id creates the row at version 1",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-import-grift-results-1"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "X": 1
        },
        "tombstoned": {},
        "absent": [],
        "events": {
          "X": {
            "create": 1
          }
        },
        "note": "No row carries the id, so the batch creates it: version 1, one create event on the import batch."
      }
    },
    {
      "name": "an existing id is replaced: version bumps once, one update event",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-import-grift-ordering-4"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, revised"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "A": 2
        },
        "tombstoned": {},
        "absent": [],
        "events": {
          "A": {
            "update": 1
          }
        },
        "note": "Upsert by id: the row exists, so this is a replace of its content."
      }
    },
    {
      "name": "skip-if-exists is the batch's, not the entity's: a new batch replaces the same id again",
      "tags": [],
      "covers": [
        "req-grid-import-grift-identity-1",
        "req-grid-import-grift-ordering-4"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, once"
                  }
                }
              ]
            }
          ]
        },
        {
          "batches": [
            {
              "name": "b2",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, twice"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          },
          {
            "success": true,
            "batches": {
              "b2": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "A": 3
        },
        "tombstoned": {},
        "absent": [],
        "events": {
          "A": {
            "update": 2
          }
        },
        "note": "Each import is a new batch id, so each runs and each replaces A."
      }
    },
    {
      "name": "a seen batch id is skipped and writes nothing",
      "tags": [],
      "covers": [
        "req-grid-import-grift-identity-1"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
