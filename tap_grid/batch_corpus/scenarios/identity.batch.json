      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          },
          {
            "success": true,
            "batches": {
              "b1": "skipped"
            },
            "errors": []
          }
        ],
        "live": {
          "X": 1
        },
        "tombstoned": {},
        "absent": [],
        "events": {
          "X": {
            "create": 1
          }
        },
        "note": "The batch id is the import identity: the second import skips it, X keeps version 1."
      }
    },
    {
      "name": "edited-in-place content of a seen batch is inert",
      "tags": [],
      "covers": [
        "req-grid-import-grift-identity-1"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
