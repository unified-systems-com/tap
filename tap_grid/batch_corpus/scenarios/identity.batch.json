        "live": {
          "X": 1
        },
        "tombstoned": {},
        "absent": [
          "Y"
        ],
        "note": "A plugin must version-bump or force-reimport; a re-sent batch never re-applies."
      }
    },
    {
      "name": "a replace of a tombstoned id fails its batch and leaves the tombstone alone",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-import-grift-preflight-2"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          }
        ],
        "edges": [],
        "tombstoned": [
          "A"
        ]
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, back"
                  }
                },
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "failed"
            },
            "errors": [
              {
                "code": "execution_failed",
                "path": "$.batches[0].nodes[0]"
              }
            ]
          }
        ],
        "live": {},
        "tombstoned": {
          "A": 2
        },
        "absent": [
          "X"
        ],
        "note": "The id exists (tombstoned) so it routes to replace, and the tombstone is terminal: the write pipeline refuses, the batch rolls back, X is not written either."
      }
    },
