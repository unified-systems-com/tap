        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X, edited"
                  }
                },
                {
                  "id": "Y",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "Y"
