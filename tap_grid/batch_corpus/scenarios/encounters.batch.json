        ],
        "live": {
          "S": 2,
          "e": 1,
          "es": 1
        },
        "tombstoned": {},
        "absent": [],
        "resolves": {
          "s": "S"
        },
        "note": "FHIR conditional create on an existing identifier: the subject is updated in place, the encounter is new, and the edge's to is S's id."
      }
