    {
      "name": "one failed conditional identity fails the whole bundle: an ambiguous subject leaves no encounter or observation behind",
      "tags": [],
      "covers": [
        "req-grid-entity-natural-key-9",
        "req-grid-import-grift-identity-3",
        "req-grid-import-grift-batch"
      ],
      "grid": {
        "nodes": [
          {
            "name": "S1",
            "type": "panel",
            "props": {
              "name": "Subject 1",
              "slug": "subject-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          },
          {
            "name": "S2",
            "type": "panel",
            "props": {
              "name": "Subject 1 (duplicate)",
              "slug": "subject-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "s",
                  "type": "panel",
                  "props": {
                    "name": "Subject 1",
                    "slug": "subject-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "e",
                  "type": "panel",
                  "props": {
                    "name": "Encounter 1",
                    "slug": "encounter-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "o1",
                  "type": "panel",
                  "props": {
                    "name": "Observation 1",
                    "slug": "obs-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ],
              "edges": [
                {
                  "ref": "es",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "e",
                  "to": "s"
                },
                {
                  "ref": "o1e",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "o1",
                  "to": "e"
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "failed"
            },
            "errors": [
              {
                "code": "identity_ambiguous",
                "path": "$.batches[0].nodes[0].entity.ref"
              }
            ]
          }
        ],
        "live": {
          "S1": 1,
          "S2": 1
        },
        "tombstoned": {},
        "absent": [
          "s",
          "e",
          "o1",
          "es",
          "o1e"
        ],
        "note": "Two live subjects carry the key: the conditional identity is ambiguous (HAPI FHIR's duplicate-conditional-create incident, as a refusal rather than a duplicate), and the transaction fails as a whole."
      }
    },
