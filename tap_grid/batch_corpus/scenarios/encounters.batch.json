{
  "family": "encounters",
  "description": "Subject / encounter / observation (from the FHIR R4 transaction bundle example, hl7.org/fhir/R4/bundle-transaction.json.html, CC0, and the transaction rules in http.html section 3.1.0.11: temporary ids, conditional identity, reference rewriting, cycles, all-or-nothing): shared references, a cycle, a mixed found/minted bundle, one failed conditional identity, and an amendment in a second bundle.",
  "scenarios": [
    {
      "name": "two observations share one subject and one encounter through refs; every edge lands on the shared rows",
      "tags": [],
      "covers": [
        "req-grid-import-grift-identity-3",
        "req-grift-edge"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "s",
                  "type": "panel",
                  "props": {
                    "name": "Subject 1",
                    "slug": "subject-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "e",
                  "type": "panel",
                  "props": {
                    "name": "Encounter 1",
                    "slug": "encounter-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "o1",
                  "type": "panel",
                  "props": {
                    "name": "Observation 1",
                    "slug": "obs-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "o2",
                  "type": "panel",
                  "props": {
                    "name": "Observation 2",
                    "slug": "obs-2",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ],
              "edges": [
                {
                  "ref": "es",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "e",
                  "to": "s"
                },
                {
                  "ref": "o1s",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "o1",
                  "to": "s"
                },
                {
                  "ref": "o1e",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "o1",
                  "to": "e"
                },
                {
                  "ref": "o2s",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "o2",
                  "to": "s"
                },
                {
                  "ref": "o2e",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "o2",
                  "to": "e"
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": [],
            "counts": {
              "b1": {
                "nodes": 4,
                "edges": 5
              }
            }
          }
        ],
        "live": {
          "s": 1,
          "e": 1,
          "o1": 1,
          "o2": 1,
          "es": 1,
          "o1s": 1,
          "o1e": 1,
          "o2s": 1,
          "o2e": 1
        },
        "tombstoned": {},
        "absent": [],
        "note": "FHIR's example bundle shape with temporary ids: four resources, five references, all rewritten to the four assigned ids (endpoints read back)."
      }
    },
    {
      "name": "a cycle: the encounter names its subject and the subject names its primary encounter",
      "tags": [],
      "covers": [
        "req-grid-import-grift-identity-3",
        "req-grift-edge"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "s",
                  "type": "panel",
                  "props": {
                    "name": "Subject 1",
                    "slug": "subject-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "e",
                  "type": "panel",
                  "props": {
                    "name": "Encounter 1",
                    "slug": "encounter-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ],
              "edges": [
                {
                  "ref": "es",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "e",
                  "to": "s"
                },
                {
                  "ref": "se",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "s",
                  "to": "e"
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "s": 1,
          "e": 1,
          "es": 1,
          "se": 1
        },
        "tombstoned": {},
        "absent": [],
        "note": "Neither node can be written 'first' with its reference complete; the gate binds both before either edge, so the cycle is fine."
      }
    },
    {
      "name": "the subject is found and the encounter is minted: a mixed bundle on a partly populated grid",
      "tags": [],
      "covers": [
        "req-grid-entity-natural-key-9",
        "req-grid-import-grift-identity-3"
      ],
      "grid": {
        "nodes": [
          {
            "name": "S",
            "type": "panel",
            "props": {
              "name": "Subject 1",
              "slug": "subject-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "s",
                  "type": "panel",
                  "props": {
                    "name": "Subject 1, updated",
                    "slug": "subject-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "e",
                  "type": "panel",
                  "props": {
                    "name": "Encounter 1",
                    "slug": "encounter-1",
