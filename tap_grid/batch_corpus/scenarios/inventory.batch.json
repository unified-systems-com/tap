    },
    {
      "name": "one genuinely ambiguous lookup: two live hosts on one key fail the batch and the interface is not written either",
      "tags": [],
      "covers": [
        "req-grid-entity-natural-key-9",
        "req-grid-import-grift-batch"
      ],
      "grid": {
        "nodes": [
          {
            "name": "H1",
            "type": "panel",
            "props": {
              "name": "host-1",
              "slug": "host-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          },
          {
            "name": "H2",
            "type": "panel",
            "props": {
              "name": "host-1 (stale copy)",
              "slug": "host-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "h",
                  "type": "panel",
                  "props": {
                    "name": "host-1",
                    "slug": "host-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                },
                {
                  "ref": "i",
                  "type": "panel",
                  "props": {
                    "name": "eth0",
                    "slug": "host-1-eth0",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ],
              "edges": [
                {
                  "ref": "e",
                  "type": "PG_LINKS__grid_fixtures",
                  "from": "h",
                  "to": "i"
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "failed"
            },
            "errors": [
              {
                "code": "identity_ambiguous",
                "path": "$.batches[0].nodes[0].entity.ref"
              }
            ]
          }
        ],
        "live": {
          "H1": 1,
          "H2": 1
        },
        "tombstoned": {},
        "absent": [
          "h",
          "i",
          "e"
        ],
        "note": "IRE's 'duplicate existing' error, as TAP words it: the payload is fine, the grid is not; the batch fails whole and names the ref."
      }
    },
    {
      "name": "a tombstoned host and a live host on one key: the lookup finds the live one only",
      "tags": [],
      "covers": [
        "req-grid-entity-natural-key-9",
        "req-grid-entity-natural-key-10",
        "req-grid-service-delete-tombstone"
      ],
      "grid": {
        "nodes": [
          {
            "name": "H0",
            "type": "panel",
            "props": {
              "name": "host-1 (old)",
              "slug": "host-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          },
          {
            "name": "H1",
            "type": "panel",
            "props": {
              "name": "host-1",
              "slug": "host-1",
              "description": "",
              "view": "tap_web/panel_error.html"
            }
          }
        ],
        "edges": [],
        "tombstoned": [
          "H0"
        ]
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "h",
                  "type": "panel",
                  "props": {
                    "name": "host-1, rescanned",
                    "slug": "host-1",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "H1": 2
        },
        "tombstoned": {
          "H0": 2
        },
        "absent": [],
        "resolves": {
          "h": "H1"
        },
        "note": "The tombstone is invisible to the search, so what would be ambiguous with two live rows is a clean find of H1."
      }
    }
  ]
