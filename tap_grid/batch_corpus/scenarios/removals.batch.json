{
  "family": "removals",
  "description": "Removal sections: deletes tombstone and purges hard-delete, after the upserts, edges before nodes; a missing or tombstoned target follows the section's policy and a type mismatch never does; a purge is DEBUG-only and takes the row's events with it, leaving a summary on the batch.",
  "scenarios": [
    {
      "name": "a delete tombstones the node, bumps once, records two delete events and ends its live edge silently",
      "tags": [],
      "covers": [
        "req-grid-import-grift-removals-1",
        "req-grid-service-delete-reason-1"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          },
          {
            "name": "C",
            "type": "grid_fixtures__node",
            "props": {
              "name": "C"
            }
          }
        ],
        "edges": [
          {
            "name": "e",
            "from": "A",
            "to": "C",
            "type": "PG_LINKS__grid_fixtures"
          }
        ]
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "deletes": {
                "on_missing": "error",
                "on_tombstoned": "ignore",
                "edges": [],
                "nodes": [
                  {
                    "id": "A",
                    "type": "grid_fixtures__node",
                    "reason": "no longer part of this seed set"
                  }
                ]
              }
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "C": 1
        },
        "tombstoned": {
          "A": 2,
          "e": 2
        },
        "absent": [],
        "events": {
          "A": {
            "delete": 2
          },
          "e": {
            "unlink": 0
          },
          "C": {}
        },
        "note": "The pipeline's delete event plus the bundle-reason event; the incident edge ends with the node (a plain delete ends edges without an unlink event); C is untouched."
      }
    },
