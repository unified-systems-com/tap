      "covers": [
        "req-grid-import-grift-dangling-1"
      ],
      "pending": "unified-systems-com/tap#610",
      "phantoms": [
        "ghost"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
