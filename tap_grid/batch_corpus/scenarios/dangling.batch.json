{
  "family": "dangling",
  "description": "Dangling edges: an endpoint that is neither a node of the file nor a row of the grid refuses the file in strict mode and skips the edge with a warning in permissive mode; a tombstoned row still counts as a row.",
  "scenarios": [
    {
      "name": "strict: an edge to nowhere refuses the file, the good node included",
      "tags": [],
      "covers": [
        "req-grid-import-grift-dangling-1",
        "req-grid-import-grift-preflight-2"
      ],
      "phantoms": [
        "ghost"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "X",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "X"
                  }
                }
              ],
              "edges": [
                {
                  "id": "e",
                  "from": "X",
                  "to": "ghost",
                  "type": "PG_LINKS__grid_fixtures"
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": false,
            "batches": {
              "b1": "refused"
            },
            "errors": [
              {
                "code": "dangling_edge",
                "path": "$.batches[0].edges[0].edge.to_entity_id"
              }
            ]
          }
        ],
        "live": {},
        "tombstoned": {},
        "absent": [
          "X",
          "e",
          "ghost"
        ],
        "note": "Preflight, strict: nothing is written."
      }
    },
    {
      "name": "permissive: the dangling edge is skipped with a warning and the rest commits",
