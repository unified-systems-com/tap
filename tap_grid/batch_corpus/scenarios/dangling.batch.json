        "tombstoned": {},
        "absent": [
          "e",
          "ghost"
        ],
        "note": "Only the offending edge is skipped; it is counted and warned. Today the batch commits but reports errors_count=1 and is left out of batches_imported (Issue# 610 - tap)."
      }
    },
