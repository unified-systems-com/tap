{
  "family": "provenance",
  "description": "What a replace writes and what it must not: both spine projections move together, an explicit empty dimensions map is a value (Issue# 608 - tap), false/zero/empty survive on the typed row, a replace resets what it omits, and every row and event is attributed to the batch that wrote it.",
  "scenarios": [
    {
      "name": "a replace with declared dimensions moves them with the name in one bump",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-entity-spine-1",
        "req-grid-import-grift-provenance-1"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, moved"
                  },
                  "dimensions": {
                    "tap.zone": "north"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "A": 2
        },
        "tombstoned": {},
        "absent": [],
        "dimensions": {
          "A": {
            "tap.zone": "north"
          }
        },
        "note": "Both spine projections — name and dimensions — come from the envelope and land in the same replace: version 2, one update event, the spine synced without a second bump."
      }
    },
