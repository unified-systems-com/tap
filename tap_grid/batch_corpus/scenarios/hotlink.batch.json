{
  "family": "hotlink",
  "description": "Deferred consistency (req-grid-hotlink-deferred): a page's exact page-panels hotlink is judged on the post-batch graph — node and hotlink edge in one batch, an invalid final graph rolls everything back, and a re-publish that moves a panel between pages validates (Issue# 351 - tap, pending).",
  "scenarios": [
    {
      "name": "a page, its panel and the hotlink edge in one batch validate against the post-batch graph",
      "tags": [],
      "covers": [
        "req-web-page-panel-id-1",
        "req-grid-import-grift-batch"
      ],
      "grid": {
        "nodes": [],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "pg",
                  "type": "page",
                  "props": {
                    "name": "Home",
                    "slug": "/home",
                    "description": "",
                    "layout": {
                      "columns": {
                        "col-1": {
                          "width": "1fr",
                          "rows": {
                            "row-1": {
                              "panel-id": "main",
                              "height": "auto"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "id": "pn",
                  "type": "panel",
                  "props": {
                    "name": "Main",
                    "slug": "main",
                    "description": "",
                    "view": "tap_web/panel_error.html"
                  }
                }
              ],
              "edges": [
                {
                  "id": "e",
                  "type": "USES_PANEL",
                  "from": "pg",
                  "to": "pn",
                  "properties": {
                    "hotlink": {
                      "model": "page",
                      "spec": "page-panels",
                      "value": "main"
                    }
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "pg": 1,
          "pn": 1,
          "e": 1
        },
        "tombstoned": {},
        "absent": [],
        "note": "The layout names panel-id 'main' and the batch's own USES_PANEL edge carries hotlink value 'main': exact mode is satisfied once the batch's edges are in."
      }
    },
