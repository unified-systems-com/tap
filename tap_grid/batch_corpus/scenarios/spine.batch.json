        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "ref": "p",
                  "type": "panel",
                  "props": {
                    "name": "Home, renamed",
                    "slug": "home",
                    "description": "",
                    "view": "tap_web/panel_error.html"
