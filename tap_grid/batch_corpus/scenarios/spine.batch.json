{
  "family": "spine",
  "description": "Provenance and spine sync on replace: the envelope is authoritative for Entity.name on every import, the sync never bumps the version, and a create takes its spine name from the envelope.",
  "scenarios": [
    {
      "name": "a replace renames the spine to the envelope's name without a second bump",
      "tags": [],
      "covers": [
        "req-grid-import-grift-batch",
        "req-grid-import-grift-provenance-1"
      ],
      "grid": {
        "nodes": [
          {
            "name": "A",
            "type": "grid_fixtures__node",
            "props": {
              "name": "A"
            }
          }
        ],
        "edges": []
      },
      "imports": [
        {
          "batches": [
            {
              "name": "b1",
              "nodes": [
                {
                  "id": "A",
                  "type": "grid_fixtures__node",
                  "props": {
                    "name": "A, renamed"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expected": {
        "imports": [
          {
            "success": true,
            "batches": {
              "b1": "committed"
            },
            "errors": []
          }
        ],
        "live": {
          "A": 2
        },
        "tombstoned": {},
        "absent": [],
        "events": {
          "A": {
            "update": 1
          }
        },
        "note": "Version 2, not 3: the spine sync is a post-pass that leaves the version alone; the runner reads Entity.name back as 'A, renamed'."
      }
    },
