          {
            "ref": "A",
            "type": "grid_fixtures__node"
          },
          {
            "ref": "B",
            "type": "grid_fixtures__node"
          }
        ],
        "edges": [
          {
            "ref": "e_R_A",
            "from": "R",
            "to": "A",
            "type": "PG_NESTS__grid_fixtures"
          },
          {
            "ref": "e_A_B",
            "from": "A",
