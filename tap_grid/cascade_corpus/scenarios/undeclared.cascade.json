{
  "family": "undeclared",
  "description": "Negative scenarios: a cascade requested where the types do not declare containment. The rule under test is that cascade is opt-in per type through CONTAINMENT_EDGES and never implied by the request, the edge, or a neighbour's declaration.",
  "scenarios": [
    {
      "name": "cascade requested but no type declares containment: only the root retires",
      "tags": [],
      "covers": [
        "req-grid-service-delete-cascade-2",
        "req-grid-service-delete-cascade-12"
      ],
      "graph": {
        "containment": {},
        "nodes": [
          {
            "ref": "R",
            "type": "grid_fixtures__node"
          },
          {
            "ref": "A",
            "type": "grid_fixtures__node"
          },
          {
            "ref": "B",
            "type": "grid_fixtures__node"
          }
        ],
        "edges": [
          {
            "ref": "e_R_A",
            "from": "R",
            "to": "A",
            "type": "PG_NESTS__grid_fixtures"
          },
          {
            "ref": "e_A_B",
            "from": "A",
            "to": "B",
            "type": "PG_NESTS__grid_fixtures"
          }
        ]
      },
      "operation": {
        "verb": "delete_node",
        "target": "R",
        "cascade": "contained"
      },
      "expected": {
        "outcome": "success",
        "retired_nodes": [
          "R"
        ],
        "retired_edges": [
          "e_R_A"
        ],
        "events": {
          "e_R_A": {
            "consequence_of": "R"
          }
        },
        "error_code": null,
        "note": "With nothing declared every edge is a reference: the root's edges end by the endpoint rule, A and B stay live. Cascade is opt-in per type, never implied by the request."
      }
    },
    {
